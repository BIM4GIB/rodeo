+            &vertices,
+            &triangles,
+            extrusion.as_ref(),
+            element.meshes.excluded_visibility_branches > 0,
+        )
+    {
+        return Ok(());
+    }
+    // A curved-profile shell admitted only by the seam tolerance (the
+    // exact rim refuses it) must have no triangle longer than half its
+    // box's diagonal; the seam tolerance is not allowed to draw a body
+    // that spans across its element.
+    if element.meshes.seam_admitted_shell
+        && has_giant_triangle_except(&vertices, &triangles, extrusion.as_ref(), &exempt)
+    {
+        return Ok(());
+    }
+    // A railing's saved mesh is taken only where it fills its record box
+    // (RE-303): every vertex within the box and each extent of the box
+    // reached, to within 0.5 ft. A railing whose graphics leave a part
+    // out, with no decoder diagnostic to say so, keeps its box.
+    if ifc_type.as_str() == "IFCRAILING"
+        && !railing_mesh_fills_box(&vertices, extrusion.as_ref())
+    {
+        report.partial += 1;
+        return Ok(());
+    }
+    // RE-224 partial admission (a few failed faces, see above): the
+    // decoded faces must fill the record box on every axis, each vertex
+    // within it to 0.5 ft, with no triangle spanning it, and the element
+    // must not be a railing (its own rule above). Anything else keeps its
+    // box, counted as partial.
+    if partial {
+        if ifc_type.as_str() == "IFCRAILING"
+            || !fills_record_box(&vertices, &triangles, extrusion.as_ref(), false)
+            || has_giant_triangle(&vertices, &triangles, extrusion.as_ref())
+        {
+            report.partial += 1;
+            return Ok(());
+        }
+        report.partial_admitted += 1;
+    }
+    // Round-14 closure check (third pass only): the welded body must be
+    // closed by the visual rule (probe/visualcheck.mts): open edges covered by
+    // another open edge within 0.003 ft are T-junctions; the rest must lie in
+    // one rim plane within 0.05 ft. Otherwise the element keeps its box.
+    if crate::research::native_parametric_surface::third_rules()
+        && !visual_closed(&vertices, &triangles)
+    {
+        report.partial += 1;
+        return Ok(());
+    }
+    report.replaced += 1;
+    report.triangles += triangles.len();
+    *solid_shape = Some(SolidShape::TriangulatedFaceSet {
+        vertices_feet: vertices,
+        triangles,
+    });
+    for property in &mut set.properties {
+        if property.name == "BodySource" {
+            property.value = PropertyValue::Text(SAVED_MESH_BODY_SOURCE.into());
+        } else if property.name == SPACE_OUTLINE_SOURCE_PROPERTY {
+            property.value = PropertyValue::Text(SPACE_OUTLINE_SAVED_MESH.into());
+        }
+    }
+    Ok(())
