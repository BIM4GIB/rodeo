+/// the span length `h` and the normalized position `s` within it.
+/// The knot interval of `x` as (index, local parameter in [0, 1], length).
+fn hermite_cell(knots: &[f64], x: f64) -> (usize, f64, f64) {
+    let mut j = 0;
+    while j + 2 < knots.len() && x > knots[j + 1] {
+        j += 1;
+    }
+    let h = knots[j + 1] - knots[j];
