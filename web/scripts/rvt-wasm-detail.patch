+/// Deviation, feet, within which a long ruling lies on its plane or cylinder.
+const RULING_TOLERANCE_FEET: f64 = 1e-6;
+
+/// Per triangle of `kept` in `primitive`: whether it is a long ruling the retry
+/// admits. Every edge longer than `limit` must be shared by exactly two
+/// triangles of the element (`uses`, over canonical vertex ids `canon`), and
+/// on a plane (the mesh's own, through its first vertex) the corners,
+/// centroid and long-edge midpoints lie within [`RULING_TOLERANCE_FEET`]; on
+/// a cylinder each long edge is a ruling by its vertex normals: the normals
+/// at its ends agree, the edge is perpendicular to them, and the third corner's
+/// normal is perpendicular to the edge (each within the tolerance).
+fn exempt_rulings(
+    primitive: &crate::research::native_saved_mesh::Primitive,
+    kept: &[[u32; 3]],
+    canon: &[u32],
+    uses: &BTreeMap<(u32, u32), usize>,
+    limit: f64,
+) -> Vec<bool> {
+    use crate::research::native_saved_mesh::FaceGeom;
+    let vertices = &primitive.vertices;
+    let normals = &primitive.normals;
+    let tol = RULING_TOLERANCE_FEET;
+    let len = |a: [f64; 3], b: [f64; 3]| (0..3).map(|k| (a[k] - b[k]).powi(2)).sum::<f64>().sqrt();
+    let dot = |a: [f64; 3], b: [f64; 3]| (0..3).map(|k| a[k] * b[k]).sum::<f64>();
+    // The plane through the first vertex with the first normal.
+    let plane = match (vertices.first(), normals.first()) {
+        (Some(v0), Some(n)) => {
+            let l = dot(*n, *n).sqrt();
+            (l > 0.).then(|| (*v0, n.map(|c| c / l)))
+        }
+        _ => None,
+    };
+    let is_cylinder = matches!(primitive.geom, Some(FaceGeom::Cylinder { .. }));
+    let is_plane = matches!(primitive.geom, Some(FaceGeom::Plane { .. }));
+    let off = |p: [f64; 3]| -> f64 {
+        match plane {
+            Some((o, n)) => dot(std::array::from_fn(|k| p[k] - o[k]), n).abs(),
+            None => f64::INFINITY,
+        }
+    };
+    kept.iter()
+        .map(|t| {
+            let c = [t[0] as usize, t[1] as usize, t[2] as usize];
+            let mut long_edges: Vec<(usize, usize, usize)> = Vec::new(); // (i, j, third)
+            for (i, j, k) in [(0usize, 1usize, 2usize), (1, 2, 0), (2, 0, 1)] {
+                let (a, b) = (c[i], c[j]);
+                if len(vertices[a], vertices[b]) <= limit {
+                    continue;
+                }
+                let (ca, cb) = (canon[a], canon[b]);
+                if uses.get(&(ca.min(cb), ca.max(cb))).copied().unwrap_or(0) != 2 {
+                    return false;
+                }
+                long_edges.push((i, j, k));
+            }
+            if long_edges.is_empty() {
+                return false;
+            }
+            if is_plane {
+                let p = [vertices[c[0]], vertices[c[1]], vertices[c[2]]];
+                let centroid: [f64; 3] = std::array::from_fn(|k| (p[0][k] + p[1][k] + p[2][k]) / 3.);
+                let on_plane = p.iter().all(|q| off(*q) <= tol) && off(centroid) <= tol;
+                let mids_ok = long_edges.iter().all(|&(i, j, _)| {
+                    off(std::array::from_fn(|k| (p[i][k] + p[j][k]) / 2.)) <= tol
+                });
+                return on_plane && mids_ok;
+            }
+            if is_cylinder {
+                return long_edges.iter().all(|&(i, j, k)| {
+                    let (a, b, third) = (c[i], c[j], c[k]);
+                    let d = std::array::from_fn::<f64, 3, _>(|q| vertices[b][q] - vertices[a][q]);
+                    let dl = dot(d, d).sqrt();
+                    if dl <= 0. {
+                        return false;
+                    }
+                    let dh = d.map(|x| x / dl);
+                    let (na, nb, nc) = (normals[a], normals[b], normals[third]);
+                    let same_angle = (0..3).all(|q| (na[q] - nb[q]).abs() <= tol);
+                    same_angle
+                        && dot(na, dh).abs() <= tol
+                        && dot(nb, dh).abs() <= tol
+                        && dot(nc, dh).abs() <= tol
+                });
+            }
+            false
+        })
+        .collect()
+}
+
+/// [`has_giant_triangle`], skipping the triangles flagged in `exempt`.
+fn has_giant_triangle_except(
+    vertices: &[[f64; 3]],
+    triangles: &[BrepTriangle],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+    exempt: &[bool],
+) -> bool {
+    let Some(x) = extrusion else {
+        return false;
+    };
+    let limit = (x.width_feet.powi(2) + x.depth_feet.powi(2) + x.height_feet.powi(2)).sqrt() / 2.;
+    let length = |a: u32, b: u32| {
+        let (p, q) = (vertices[a as usize], vertices[b as usize]);
+        (0..3).map(|k| (p[k] - q[k]).powi(2)).sum::<f64>().sqrt()
+    };
+    // A flat panel lying in a plane parallel to a side of the box (an
+    // appliance's side wall) is drawn by long triangles of its own; only a
+    // triangle crossing the box out of such a plane counts.
+    let axis_flat = |t: &BrepTriangle| {
+        let (a, b, c) = (vertices[t.0 as usize], vertices[t.1 as usize], vertices[t.2 as usize]);
+        (0..3).any(|k| (a[k] - b[k]).abs() <= AXIS_FLAT_FEET && (a[k] - c[k]).abs() <= AXIS_FLAT_FEET)
+    };
+    triangles.iter().enumerate().any(|(i, t)| {
+        !exempt.get(i).copied().unwrap_or(false)
+            && (length(t.0, t.1) > limit || length(t.1, t.2) > limit || length(t.2, t.0) > limit)
+            && !axis_flat(t)
+    })
+}
+
+/// How far a triangle's vertices may differ along one axis for it to count as
+/// lying in a plane parallel to a side of the record box.
+const AXIS_FLAT_FEET: f64 = 0.003;
+
+/// Whether `vertices`, in the element's frame (origin at its location, the
+/// box's x and y centred on it, its z from 0 up), lie within `extrusion`'s box
+/// and reach each of its faces, to within [`RAILING_BOX_TOLERANCE_FEET`].
+fn railing_mesh_fills_box(
+    vertices: &[[f64; 3]],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+) -> bool {
+    let Some(e) = extrusion else {
+        return false;
+    };
+    let half = [e.width_feet / 2.0, e.depth_feet / 2.0];
+    let tol = RAILING_BOX_TOLERANCE_FEET;
+    let lo = [-half[0], -half[1], 0.0];
+    let hi = [half[0], half[1], e.height_feet];
+    let mut min = [f64::INFINITY; 3];
+    let mut max = [f64::NEG_INFINITY; 3];
+    for v in vertices {
+        for k in 0..3 {
+            min[k] = min[k].min(v[k]);
+            max[k] = max[k].max(v[k]);
+        }
+    }
+    (0..3).all(|k| min[k] >= lo[k] - tol && max[k] <= hi[k] + tol)
+        && (0..3).all(|k| min[k] <= lo[k] + tol && max[k] >= hi[k] - tol)
+}
+
+/// How far a railing's saved mesh may stop short of its record box, or reach
+/// beyond it, in feet. Revit's own railing boxes sit about 0.165 ft above the top of
+/// their graphics on every railing measured on the sample projects.
+const RAILING_BOX_TOLERANCE_FEET: f64 = 0.5;
+
+/// The visual closure rule of probe/visualcheck.mts (round 14): vertices
+/// within 0.003 ft merge; an open edge every sample of which lies within
+/// 0.003 ft of another open edge is a T-junction; the remaining gaps must
+/// lie within 0.05 ft of one axis plane.
+fn visual_closed(vertices: &[[f64; 3]], triangles: &[BrepTriangle]) -> bool {
+    const VISUAL: f64 = 0.003;
+    let n = vertices.len();
+    let mut parent: Vec<usize> = (0..n).collect();
+    fn find(parent: &mut [usize], mut i: usize) -> usize {
+        while parent[i] != i {
+            parent[i] = parent[parent[i]];
+            i = parent[i];
+        }
+        i
+    }
+    let dist = |p: [f64; 3], q: [f64; 3]| ((p[0] - q[0]).powi(2) + (p[1] - q[1]).powi(2) + (p[2] - q[2]).powi(2)).sqrt();
+    let cell = |p: [f64; 3]| [(p[0] / VISUAL).floor() as i64, (p[1] / VISUAL).floor() as i64, (p[2] / VISUAL).floor() as i64];
+    let mut grid: BTreeMap<[i64; 3], Vec<usize>> = BTreeMap::new();
+    for (i, p) in vertices.iter().enumerate() {
+        let c = cell(*p);
+        for dx in -1..=1 {
+            for dy in -1..=1 {
+                for dz in -1..=1 {
+                    if let Some(list) = grid.get(&[c[0] + dx, c[1] + dy, c[2] + dz]) {
+                        for &j in list {
+                            if dist(*p, vertices[j]) < VISUAL {
+                                let (ri, rj) = (find(&mut parent, i), find(&mut parent, j));
+                                parent[ri] = rj;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        grid.entry(c).or_default().push(i);
+    }
+    let mut edges: BTreeMap<(usize, usize), (u32, [f64; 3], [f64; 3])> = BTreeMap::new();
+    for t in triangles {
+        let v = [t.0 as usize, t.1 as usize, t.2 as usize];
+        for (x, y) in [(v[0], v[1]), (v[1], v[2]), (v[2], v[0])] {
+            let (cx, cy) = (find(&mut parent, x), find(&mut parent, y));
+            if cx == cy {
+                continue;
+            }
+            let key = (cx.min(cy), cx.max(cy));
+            let e = edges.entry(key).or_insert((0, vertices[x], vertices[y]));
+            e.0 += 1;
+        }
+    }
+    let open: Vec<([f64; 3], [f64; 3])> = edges.values().filter(|e| e.0 == 1).map(|e| (e.1, e.2)).collect();
+    if open.is_empty() {
+        return true;
+    }
+    let seg_dist = |p: [f64; 3], a: [f64; 3], b: [f64; 3]| {
+        let d: [f64; 3] = std::array::from_fn(|k| b[k] - a[k]);
+        let len2: f64 = d.iter().map(|x| x * x).sum();
+        let t = if len2 > 0. {
+            ((0..3).map(|k| (p[k] - a[k]) * d[k]).sum::<f64>() / len2).clamp(0., 1.)
+        } else {
+            0.
+        };
+        dist(p, std::array::from_fn(|k| a[k] + t * d[k]))
+    };
+    let mut gaps: Vec<[f64; 3]> = Vec::new();
+    for (i, (a, b)) in open.iter().enumerate() {
+        let covered_all = (0..=4).all(|k| {
+            let t = k as f64 / 4.;
+            let p: [f64; 3] = std::array::from_fn(|c| a[c] + t * (b[c] - a[c]));
+            open.iter().enumerate().any(|(j, (c, d))| j != i && seg_dist(p, *c, *d) <= VISUAL)
+        });
+        if !covered_all {
+            gaps.push(std::array::from_fn(|c| (a[c] + b[c]) / 2.));
+        }
+    }
+    if gaps.is_empty() {
+        return true;
+    }
+    (0..3).any(|ax| {
+        let lo = gaps.iter().map(|m| m[ax]).fold(f64::INFINITY, f64::min);
+        let hi = gaps.iter().map(|m| m[ax]).fold(f64::NEG_INFINITY, f64::max);
+        hi - lo <= 0.05
+    })
+}
