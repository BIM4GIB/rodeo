+/// The admission of one element's saved graphics as its body: a decoded body
+/// that passes every gate replaces the element's box. Counts go to `report`.
+fn admit_element(element: &SavedElement, index: usize, model: &mut IfcModel, report: &mut SavedMeshReport) -> anyhow::Result<()> {
+    let primitives = &element.meshes.primitives;
+    if primitives.is_empty() {
+        return Ok(());
+    }
+    // RE-224: a mesh some face or branch of which did not decode is only
+    // part of the body (on a public reference office 357 such meshes, none of
+    // them Revit's body). Only branches left out for their view semantics
+    // leave it whole. A partial mesh whose few failed faces leave its
+    // decoded faces the body is admitted further down, after the checks
+    // that follow.
+    let failed: Vec<&String> = element
+        .meshes
+        .diagnostics
+        .iter()
+        .filter(|diagnostic| {
+            !diagnostic.ends_with(
+                crate::native_graphics_traversal::NESTED_DETAIL_FILTER_DIAGNOSTIC,
+            ) && !diagnostic
+                .ends_with(crate::native_graphics_traversal::VIEW_COMPONENT_DIAGNOSTIC)
+        })
+        .collect();
+    let partial = !failed.is_empty();
+    if partial && !partial_failures_admissible(&failed, primitives.len()) {
+        report.partial += 1;
+        return Ok(());
+    }
+    let IfcEntity::BuildingElement {
+        ifc_type,
+        location_feet: Some(origin),
+        rotation_radians,
+        extrusion,
+        solid_shape,
+        property_set: Some(set),
+        ..
+    } = &mut model.entities[index]
+    else {
+        return Ok(());
+    };
+    let (sin, cos) = (-rotation_radians.unwrap_or(0.0)).sin_cos();
+    let mut vertices = Vec::new();
+    let mut triangles = Vec::new();
+    // Per triangle: a long ruling on a plane or cylinder that the retry may
+    // admit (see `exempt_rulings`). Empty unless the retry is on.
+    let mut exempt: Vec<bool> = Vec::new();
+    let refine3d = crate::research::native_parametric_trim::REFINE_3D
+        .load(std::sync::atomic::Ordering::Relaxed);
+    let limit = extrusion
+        .as_ref()
+        .map(|x| (x.width_feet.powi(2) + x.depth_feet.powi(2) + x.height_feet.powi(2)).sqrt() / 2.);
+    // Per primitive, the triangles that survive the index filter.
+    let kept_all: Vec<Vec<[u32; 3]>> = primitives
+        .iter()
+        .map(|primitive| {
+            primitive
+                .triangles
+                .iter()
+                .filter(|t| t.iter().all(|&v| (v as usize) < primitive.vertices.len()))
+                .copied()
+                .collect()
+        })
+        .collect();
+    // The retry's exemption: a long triangle is admitted only where each of its
+    // long edges is shared by exactly two triangles of the whole element, with
+    // endpoints matched in 3D to 1e-6 ft (a face's rim is shared with its
+    // neighbour; an edge used once is a real open edge).
+    let mut exempt_by_prim: Vec<Vec<bool>> = Vec::new();
+    if refine3d {
+        let mut canon_of: BTreeMap<[i64; 3], u32> = BTreeMap::new();
+        let mut canon: Vec<Vec<u32>> = Vec::new();
+        for primitive in primitives {
+            let ids = primitive
+                .vertices
+                .iter()
+                .map(|v| {
+                    let key = v.map(|c| (c * 1e6).round() as i64);
+                    let next = canon_of.len() as u32;
+                    *canon_of.entry(key).or_insert(next)
