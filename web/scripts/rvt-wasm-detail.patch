+/// The meshes of one geometry object's faces. Under the round-8 rules, a
+/// face whose boundary chord is too coarse takes a 3D split point on the
+/// shared trim edge, planned from both faces' surfaces; both faces are then
+/// meshed again with that point, for up to three rounds. A split kept only
+/// when both faces of its edge took it. Other rules leave the faces as they
+/// are.
+fn geometry_face_meshes(
+    g: &ObjectGraph,
+    index: &PointerIndex<'_>,
+    faces: &[usize],
+) -> Result<Vec<(usize, Option<FaceMesh>)>> {
+    use crate::research::native_parametric_trim as trim;
+    trim::splits_clear();
+    let result = (|| -> Result<Vec<(usize, Option<FaceMesh>)>> {
+        // Each face keeps its last mesh. A round re-meshes only the faces
+        // that are new or share an edge that took a split.
+        let mut results: Vec<Option<Result<Option<FaceMesh>>>> =
+            (0..faces.len()).map(|_| None).collect();
+        let mut dirty: BTreeSet<usize> = (0..faces.len()).collect();
+        for round in 0..=3 {
+            let mut chords = Vec::new();
+            for &pos in &dirty {
+                let r = face_indexed(g, index, faces[pos]);
+                if let Err(e) = &r {
+                    if let Some(ce) = e.downcast_ref::<trim::ChordEdge>() {
+                        chords.push((pos, *ce));
+                    }
+                }
+                results[pos] = Some(r);
+            }
+            if results.iter().all(|r| matches!(r, Some(Ok(_)))) {
+                // Every split must be taken by both of its faces, or the
+                // shared boundary would open.
+                for e in trim::split_edges() {
+                    let pair = g.objects[e].fields["m_pFace"]
+                        .as_array()
+                        .context("edge face pair")?;
+                    for p in pair {
+                        if let Some(f) = pointer(g, e, p)? {
+                            ensure!(
+                                faces.contains(&f) && trim::consumed(f, e),
+                                "shared split not taken by both faces"
+                            );
+                        }
+                    }
+                }
+                let mut out = Vec::with_capacity(faces.len());
+                for (pos, r) in results.into_iter().enumerate() {
+                    out.push((faces[pos], r.context("face result")??));
+                }
+                return Ok(out);
+            }
+            let first_error = || -> anyhow::Error {
+                results
+                    .iter()
+                    .find_map(|r| match r {
+                        Some(Err(e)) => Some(anyhow::anyhow!("{e:#}")),
+                        _ => None,
+                    })
+                    .unwrap_or_else(|| anyhow::anyhow!("face result missing"))
+            };
+            if round == 3 || chords.is_empty() {
+                return Err(first_error());
+            }
+            let mut next = BTreeSet::new();
+            for (pos, ce) in chords {
+                if let Some((e, p)) = trim::plan_split(g, faces[pos], &ce)? {
+                    if trim::split_add(e, p) {
+                        let pair = g.objects[e].fields["m_pFace"]
+                            .as_array()
+                            .context("edge face pair")?;
+                        for q in pair {
+                            if let Some(f) = pointer(g, e, q)? {
+                                if let Some(k) = faces.iter().position(|&x| x == f) {
+                                    next.insert(k);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            if next.is_empty() {
+                return Err(first_error());
+            }
+            dirty = next;
+        }
+        bail!("chord split rounds exhausted")
+    })();
+    trim::splits_clear();
+    result
