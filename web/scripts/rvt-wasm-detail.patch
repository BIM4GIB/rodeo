+                    ring = close_through_collapsed(surface, ring)?;
+                }
+                ensure!(ring.len() >= 3, "degenerate trim ring");
+                return Ok(ring);
+            }
+        }
+    }
+    bail!("disconnected parametric trim")
+}
+
+thread_local! {
+    /// Round-11 third pass: the orientation test is exact (integer grid,
+    /// i128). Set only while plane_loop_triangles runs.
+    static EXACT_ORIENT: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Twice the signed area of the UV triangle (a, b, c). Exact on the integer
+/// grid of the third pass (see plane_loop_triangles), plain f64 elsewhere.
+fn cross2(a: Uv, b: Uv, c: Uv) -> f64 {
+    if EXACT_ORIENT.with(|c| c.get()) {
+        let d = |x: f64, y: f64| (x - y) as i128;
+        let (bx, by) = (d(b[0], a[0]), d(b[1], a[1]));
+        let (cx, cy) = (d(c[0], a[0]), d(c[1], a[1]));
+        return (bx * cy - by * cx) as f64;
+    }
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
+
+fn signed_area(r: &[Uv]) -> f64 {
+    0.5 * (0..r.len())
+        .map(|i| {
+            let a = r[i];
+            let b = r[(i + 1) % r.len()];
+            a[0] * b[1] - b[0] * a[1]
+        })
+        .sum::<f64>()
+}
+
+/// Whether `p` lies inside `r` by the even-odd rule.
+fn inside(p: Uv, r: &[Uv]) -> bool {
+    let mut hit = false;
+    for i in 0..r.len() {
+        let a = r[i];
+        let b = r[(i + 1) % r.len()];
+        if (a[1] > p[1]) != (b[1] > p[1]) && p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0] {
+            hit = !hit;
+        }
+    }
+    hit
+}
+
+/// The squared distance from `p` to the segment `a`-`b`.
+fn segment_distance2(p: Uv, a: Uv, b: Uv) -> f64 {
+    let (dx, dy) = (b[0] - a[0], b[1] - a[1]);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0. {
+        (((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / len2).clamp(0., 1.)
+    } else {
+        0.
+    };
+    let (ex, ey) = (p[0] - (a[0] + t * dx), p[1] - (a[1] + t * dy));
+    ex * ex + ey * ey
+}
+
+/// The distance from `p` to the segment `a`-`b`.
+fn segment_distance(p: Uv, a: Uv, b: Uv) -> f64 {
+    let (dx, dy) = (b[0] - a[0], b[1] - a[1]);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0. {
+        (((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / len2).clamp(0., 1.)
+    } else {
+        0.
+    };
+    (p[0] - (a[0] + t * dx)).hypot(p[1] - (a[1] + t * dy))
+}
+
+/// The point of `tris` containing `p` strictly, if any.
+fn containing(uv: &[Uv], tris: &[[u32; 3]], p: Uv) -> Option<usize> {
+    tris.iter().position(|t| {
+        let [a, b, c] = [uv[t[0] as usize], uv[t[1] as usize], uv[t[2] as usize]];
+        cross2(a, b, p) > 1e-12 && cross2(b, c, p) > 1e-12 && cross2(c, a, p) > 1e-12
+    })
+}
+
+/// Whether `p` lies more than `thr` from every segment of every ring. The
+/// squared test settles every clear-cut case; only a point within a hair of
+/// the threshold pays for the exact distance.
+fn clear_of(p: Uv, rings: &[&[Uv]], thr: f64) -> bool {
+    let far2 = thr * thr * (1. + 1e-6);
+    rings.iter().all(|r| {
+        (0..r.len()).all(|k| {
+            let (a, b) = (r[k], r[(k + 1) % r.len()]);
+            // A segment is no nearer than its bounding box, so a box that is
+            // far enough settles the segment without its distance.
+            let gap = |v: f64, lo: f64, hi: f64| (lo - v).max(v - hi).max(0.);
+            let (gx, gy) = (gap(p[0], a[0].min(b[0]), a[0].max(b[0])), gap(p[1], a[1].min(b[1]), a[1].max(b[1])));
+            gx * gx + gy * gy > far2 || segment_distance2(p, a, b) > far2 || segment_distance(p, a, b) > thr
+        })
+    })
+}
+
+/// The triangulation of the boundary `tris` with interior lattice points
+/// added at `divisions` per UV-box axis, each split into its triangle.
+fn lattice_refine(
+    outer: &[Uv],
+    holes: &[Vec<Uv>],
+    boundary: &[Uv],
+    tris: &[[u32; 3]],
+    divisions: usize,
+) -> Result<(Vec<Uv>, Vec<[u32; 3]>)> {
+    let mut uv = boundary.to_vec();
+    let mut tris = tris.to_vec();
+    if divisions == 0 {
+        return Ok((uv, tris));
+    }
+    let min: Uv = std::array::from_fn(|k| outer.iter().map(|p| p[k]).fold(f64::INFINITY, f64::min));
+    let max: Uv = std::array::from_fn(|k| outer.iter().map(|p| p[k]).fold(f64::NEG_INFINITY, f64::max));
+    let step = [(max[0] - min[0]) / divisions as f64, (max[1] - min[1]) / divisions as f64];
+    let rings: Vec<&[Uv]> = std::iter::once(outer).chain(holes.iter().map(Vec::as_slice)).collect();
+    for i in 1..divisions {
+        for j in 1..divisions {
+            let p = [min[0] + step[0] * i as f64, min[1] + step[1] * j as f64];
+            let inside_trim = inside(p, outer) && holes.iter().all(|h| !inside(p, h));
+            if !inside_trim {
+                continue;
+            }
+            // Keep lattice points off the boundary so no triangle is a sliver.
+            if !clear_of(p, &rings, 0.25 * step[0].min(step[1])) {
+                continue;
+            }
+            let found = containing(&uv, &tris, p);
+            let Some(t) = found else {
+                continue;
+            };
+            ensure!(tris.len() < MAX_TRIANGLES && uv.len() < MAX_VERTICES, "trimmed face exceeds its budget");
+            let q = uv.len() as u32;
+            uv.push(p);
+            let [a, b, c] = tris[t];
+            tris[t] = [a, b, q];
+            tris.push([b, c, q]);
+            tris.push([c, a, q]);
+        }
+    }
+    Ok((uv, tris))
+}
+
+/// Whether `p` lies in the trim region: inside the outer loop and in no hole.
+fn in_region(p: Uv, rings: &[Vec<Uv>]) -> bool {
+    rings.iter().filter(|r| inside(p, r)).count() % 2 == 1
+}
+
+/// Whether the segments `a`-`b` and `u`-`v` cross at a point interior to both.
+fn crosses(a: Uv, b: Uv, u: Uv, v: Uv) -> bool {
+    cross2(a, b, u) * cross2(a, b, v) < 0. && cross2(u, v, a) * cross2(u, v, b) < 0.
+}
+
+/// Positive when `d` lies inside the circumcircle of the counter-clockwise
+/// triangle (a, b, c).
+fn in_circle(a: Uv, b: Uv, c: Uv, d: Uv) -> f64 {
+    if EXACT_ORIENT.with(|c| c.get()) {
+        // Third pass: exact. Points are multiples of 1/2 on the integer grid
+        // (super-triangle corners included); doubled, the test is in i128.
+        let e = |p: Uv| -> [i128; 2] { [(p[0] * 2.) as i128, (p[1] * 2.) as i128] };
+        let (pa, pb, pc, pd) = (e(a), e(b), e(c), e(d));
+        let ax = pa[0] - pd[0];
+        let ay = pa[1] - pd[1];
+        let bx = pb[0] - pd[0];
+        let by = pb[1] - pd[1];
+        let cx = pc[0] - pd[0];
+        let cy = pc[1] - pd[1];
+        let (a2, b2, c2) = (ax * ax + ay * ay, bx * bx + by * by, cx * cx + cy * cy);
+        let det = ax * (by * c2 - b2 * cy) - ay * (bx * c2 - b2 * cx) + a2 * (bx * cy - by * cx);
+        return det as f64;
+    }
+    let (ax, ay) = (a[0] - d[0], a[1] - d[1]);
+    let (bx, by) = (b[0] - d[0], b[1] - d[1]);
+    let (cx, cy) = (c[0] - d[0], c[1] - d[1]);
+    let (a2, b2, c2) = (ax * ax + ay * ay, bx * bx + by * by, cx * cx + cy * cy);
+    ax * (by * c2 - b2 * cy) - ay * (bx * c2 - b2 * cx) + a2 * (bx * cy - by * cx)
+}
+
+/// The middle of the triangle `t` of `uv`.
+fn centroid(uv: &[Uv], t: [u32; 3]) -> Uv {
+    let [a, b, c] = t.map(|k| uv[k as usize]);
+    [(a[0] + b[0] + c[0]) / 3., (a[1] + b[1] + c[1]) / 3.]
+}
+
+/// The circumcentre of the triangle (a, b, c), or `None` when it is flat.
+fn circumcentre(a: Uv, b: Uv, c: Uv) -> Option<Uv> {
+    let (bx, by) = (b[0] - a[0], b[1] - a[1]);
+    let (cx, cy) = (c[0] - a[0], c[1] - a[1]);
+    let d = 2. * (bx * cy - by * cx);
+    if d.abs() <= 1e-18 {
+        return None;
+    }
+    let (b2, c2) = (bx * bx + by * by, cx * cx + cy * cy);
+    Some([a[0] + (cy * b2 - by * c2) / d, a[1] + (bx * c2 - cx * b2) / d])
+}
+
+/// Bowyer-Watson Delaunay triangulation of `pts`, counter-clockwise. Points
+/// are inserted one at a time into a super-triangle, which is removed at the
+/// end. Points must be distinct.
+fn delaunay(pts: &[Uv]) -> Vec<[u32; 3]> {
+    let n = pts.len();
+    let min: Uv = std::array::from_fn(|k| pts.iter().map(|p| p[k]).fold(f64::INFINITY, f64::min));
+    let max: Uv = std::array::from_fn(|k| pts.iter().map(|p| p[k]).fold(f64::NEG_INFINITY, f64::max));
+    let span = (max[0] - min[0]).max(max[1] - min[1]).max(1e-9);
+    let (mx, my) = ((min[0] + max[0]) / 2., (min[1] + max[1]) / 2.);
+    let mut all = pts.to_vec();
+    let _ = (mx, my);
+    // The round-6 rules need a super-triangle far larger than the samples:
+    // at 100 spans, near-collinear boundary samples lose hull edges.
+    let k = if crate::research::native_parametric_surface::new_rules() { 1e4 } else { 100. };
+    all.push([mx - k * span, my - k * span]);
+    all.push([mx + k * span, my - k * span]);
+    all.push([mx, my + k * span]);
+    let s = n as u32;
+    let mut tris: Vec<[u32; 3]> = vec![[s, s + 1, s + 2]];
+    for (i, &p) in pts.iter().enumerate() {
+        // Directed edges of the triangles whose circumcircle holds p.
+        let mut cavity = BTreeSet::new();
+        let mut keep = Vec::with_capacity(tris.len() + 2);
+        for t in tris.drain(..) {
+            let [a, b, c] = t;
+            if in_circle(all[a as usize], all[b as usize], all[c as usize], p) > 0. {
+                cavity.extend([(a, b), (b, c), (c, a)]);
+            } else {
+                keep.push(t);
+            }
+        }
+        for &(a, b) in &cavity {
+            if !cavity.contains(&(b, a)) {
+                keep.push([a, b, i as u32]);
+            }
+        }
+        tris = keep;
+    }
+    tris.retain(|t| t.iter().all(|&k| k < s));
+    tris
+}
+
+/// The third vertex of `t` when `t` has
+/// the directed edge `u`-`v`, is the third vertex.
+fn third_of(t: [u32; 3], u: u32, v: u32) -> Option<u32> {
+    (0..3)
+        .find(|&k| t[k] == u && t[(k + 1) % 3] == v)
+        .map(|k| t[(k + 2) % 3])
+}
+
+/// The two triangles on either side of the edge `u`-`v`, each with its third
+/// vertex: the one that has `u`-`v` in its order, then the one with `v`-`u`.
+fn sides(tris: &[[u32; 3]], u: u32, v: u32) -> Option<((usize, u32), (usize, u32))> {
+    let a = tris.iter().enumerate().find_map(|(i, t)| third_of(*t, u, v).map(|x| (i, x)));
+    let b = tris.iter().enumerate().find_map(|(i, t)| third_of(*t, v, u).map(|y| (i, y)));
+    Some((a?, b?))
+}
+
+/// Each constraint with the trim samples that lie exactly on it (within
+/// 1e-12 of its span) split out: the constraint `a`-`b` becomes the chain
+/// `a`, `v1`, ..., `b` through those samples, so no new point is needed.
+fn split_constraints(pts: &[Uv], constraints: &[(u32, u32)]) -> Vec<(u32, u32)> {
+    let mut out = Vec::with_capacity(constraints.len());
+    for &(a, b) in constraints {
+        let (pa, pb) = (pts[a as usize], pts[b as usize]);
+        let len = ((pb[0] - pa[0]).powi(2) + (pb[1] - pa[1]).powi(2)).sqrt();
+        let mut on: Vec<(f64, u32)> = Vec::new();
+        for (k, &p) in pts.iter().enumerate() {
+            let k = k as u32;
+            if k == a || k == b {
+                continue;
+            }
+            let along = ((p[0] - pa[0]) * (pb[0] - pa[0]) + (p[1] - pa[1]) * (pb[1] - pa[1])) / len;
+            if cross2(pa, pb, p).abs() / len <= 1e-12 && along > 0. && along < len {
+                on.push((along, k));
+            }
+        }
+        on.sort_by(|x, y| x.0.total_cmp(&y.0));
+        let mut prev = a;
+        for (_, k) in on {
+            out.push((prev, k));
+            prev = k;
+        }
+        out.push((prev, b));
+    }
+    out
+}
+
+/// Whether `p` lies in the closed triangle (a, b, c) of counter-clockwise order.
+fn in_closed_triangle(a: Uv, b: Uv, c: Uv, p: Uv) -> bool {
+    cross2(a, b, p) >= 0. && cross2(b, c, p) >= 0. && cross2(c, a, p) >= 0.
+}
+
+/// Ear clipping of a simple counter-clockwise polygon of sample indices.
+/// Returns its triangles, or `None` when no ear exists (a degenerate loop).
+fn ear_clip(pts: &[Uv], mut poly: Vec<u32>) -> Option<Vec<[u32; 3]>> {
+    let mut out = Vec::with_capacity(poly.len().saturating_sub(2));
+    while poly.len() > 3 {
+        let n = poly.len();
+        let mut found = None;
+        for i in 0..n {
+            let (p, c, q) = (poly[(i + n - 1) % n], poly[i], poly[(i + 1) % n]);
+            let (pp, pc, pq) = (pts[p as usize], pts[c as usize], pts[q as usize]);
+            if cross2(pp, pc, pq) <= 0. {
+                continue;
+            }
+            let blocked = poly.iter().any(|&r| {
+                r != p && r != c && r != q && in_closed_triangle(pp, pc, pq, pts[r as usize])
+            });
+            if !blocked {
+                found = Some(i);
+                break;
+            }
+        }
+        let i = found?;
+        let n = poly.len();
+        out.push([poly[(i + n - 1) % n], poly[i], poly[(i + 1) % n]]);
+        poly.remove(i);
+    }
+    let (x, y, z) = (poly[0], poly[1], poly[2]);
+    if cross2(pts[x as usize], pts[y as usize], pts[z as usize]) > 0. {
+        out.push([x, y, z]);
+    }
+    Some(out)
+}
+
+/// Inserts the constraint `a`-`b` by cavity retriangulation (Anglada 1997):
+/// the triangles it crosses are removed, and the two polygons they leave on
+/// either side of it are ear-clipped. No point is added. Returns `false` when
+/// the cavity is not a simple polygon on each side.
+fn cavity_insert(pts: &[Uv], tris: &mut Vec<[u32; 3]>, a: u32, b: u32) -> bool {
+    let (pa, pb) = (pts[a as usize], pts[b as usize]);
+    let crossed: Vec<usize> = (0..tris.len())
+        .filter(|&i| {
+            let t = tris[i];
+            (0..3).any(|k| {
+                let (u, v) = (t[k], t[(k + 1) % 3]);
+                u != a && u != b && v != a && v != b && crosses(pa, pb, pts[u as usize], pts[v as usize])
+            })
+        })
+        .collect();
+    if crossed.is_empty() {
+        return false;
+    }
+    let mut directed = BTreeSet::new();
+    for &i in &crossed {
+        let t = tris[i];
+        for k in 0..3 {
+            directed.insert((t[k], t[(k + 1) % 3]));
+        }
+    }
+    // Boundary edges of the cavity, each on one side of a-b.
+    let mut sides: [Vec<(u32, u32)>; 2] = [Vec::new(), Vec::new()];
+    for &(u, v) in &directed {
+        if directed.contains(&(v, u)) {
+            continue;
+        }
+        let p = if u == a || u == b { v } else { u };
+        let s = cross2(pa, pb, pts[p as usize]);
+        if s == 0. {
+            return false;
+        }
+        sides[usize::from(s < 0.)].push((u, v));
+    }
+    let mut new_tris = Vec::new();
+    for side in &sides {
+        // The chain of the cavity boundary on this side, from a to b.
+        let mut adj: BTreeMap<u32, Vec<u32>> = BTreeMap::new();
+        for &(u, v) in side {
+            adj.entry(u).or_default().push(v);
+            adj.entry(v).or_default().push(u);
+        }
+        if adj.get(&a).map_or(true, |n| n.len() != 1) || adj.get(&b).map_or(true, |n| n.len() != 1) {
+            return false;
+        }
+        let mut path = vec![a];
+        let mut prev = None;
+        let mut cur = a;
+        while cur != b {
+            let next: Vec<u32> = adj
+                .get(&cur)
+                .map(|n| n.iter().copied().filter(|&x| Some(x) != prev).collect())
+                .unwrap_or_default();
+            if next.len() != 1 || path.len() > side.len() + 1 {
+                return false;
+            }
+            prev = Some(cur);
+            cur = next[0];
+            path.push(cur);
+        }
+        let area: f64 = path
+            .iter()
+            .zip(path.iter().cycle().skip(1))
+            .map(|(&u, &v)| {
+                let (p, q) = (pts[u as usize], pts[v as usize]);
+                p[0] * q[1] - q[0] * p[1]
+            })
+            .sum();
+        if area.abs() <= 1e-18 {
+            return false;
+        }
+        if area < 0. {
+            path.reverse();
+        }
+        match ear_clip(pts, path) {
+            Some(t) => new_tris.extend(t),
+            None => return false,
+        }
+    }
+    let crossed: BTreeSet<usize> = crossed.into_iter().collect();
+    let mut kept: Vec<[u32; 3]> = tris
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| !crossed.contains(i))
+        .map(|(_, t)| *t)
+        .collect();
+    kept.extend(new_tris);
+    *tris = kept;
+    true
+}
+
+/// Forces each constraint segment into the triangulation as an edge. The
+/// edges crossing it are flipped until none does (Sloan's method); where
+/// that fails under the round-6 rules, the triangulation is restored and the
+/// constraint is inserted by cavity retriangulation instead. A constraint
+/// that still is not an edge is refused.
+fn constrain(pts: &[Uv], tris: &mut Vec<[u32; 3]>, constraints: &[(u32, u32)]) -> Result<()> {
+    let round6 = crate::research::native_parametric_surface::new_rules();
+    let segments = if round6 {
+        split_constraints(pts, constraints)
+    } else {
+        for &(a, b) in constraints {
+            let (pa, pb) = (pts[a as usize], pts[b as usize]);
+            let len2 = (pb[0] - pa[0]).powi(2) + (pb[1] - pa[1]).powi(2);
+            for (k, &p) in pts.iter().enumerate() {
+                let k = k as u32;
+                if k == a || k == b {
+                    continue;
+                }
+                let along = (p[0] - pa[0]) * (pb[0] - pa[0]) + (p[1] - pa[1]) * (pb[1] - pa[1]);
+                ensure!(
+                    !(cross2(pa, pb, p).abs() <= 1e-12 && along > 0. && along < len2),
+                    "trim sample lies on another trim edge"
+                );
+            }
+        }
+        constraints.to_vec()
+    };
+    for &(a, b) in &segments {
+        let (pa, pb) = (pts[a as usize], pts[b as usize]);
+        let mut edges: Vec<(u32, u32)> = tris
+            .iter()
+            .flat_map(|t| [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])])
+            .map(|(u, v)| (u.min(v), u.max(v)))
+            .collect();
+        if edges.contains(&(a.min(b), a.max(b))) {
+            continue;
+        }
+        let backup = round6.then(|| tris.clone());
+        edges.sort_unstable();
+        edges.dedup();
+        let mut queue: VecDeque<(u32, u32)> = edges
+            .iter()
+            .copied()
+            .filter(|&(u, v)| crosses(pa, pb, pts[u as usize], pts[v as usize]))
+            .collect();
+        let mut steps = 0usize;
+        let mut sloan_ok = true;
+        while let Some((u, v)) = queue.pop_front() {
+            steps += 1;
+            if steps > 1_000_000 {
+                ensure!(round6, "trim constraint recovery stalled");
+                sloan_ok = false;
+                break;
+            }
+            if !crosses(pa, pb, pts[u as usize], pts[v as usize]) {
+                continue;
+            }
+            let Some(((i, x), (j, y))) = sides(tris, u, v) else {
+                continue;
+            };
+            let (pu, pv) = (pts[u as usize], pts[v as usize]);
+            let (px, py) = (pts[x as usize], pts[y as usize]);
+            // The quadrilateral u, y, v, x is convex exactly when its
+            // diagonals u-v and x-y cross.
+            if cross2(px, py, pu) * cross2(px, py, pv) >= 0. {
+                queue.push_back((u, v));
+                continue;
+            }
+            tris[i] = [u, y, x];
+            tris[j] = [v, x, y];
+            if crosses(pa, pb, px, py) {
+                queue.push_back((x.min(y), x.max(y)));
+            }
+        }
+        let recovered = |tris: &[[u32; 3]]| {
+            tris.iter().any(|t| {
+                [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])]
+                    .iter()
+                    .any(|&(u, v)| (u, v) == (a, b) || (v, u) == (a, b))
+            })
+        };
+        if sloan_ok && recovered(tris) {
+            continue;
+        }
+        if let Some(backup) = backup {
+            *tris = backup;
+            if cavity_insert(pts, tris, a, b) && recovered(tris) {
+                continue;
+            }
+        }
+        bail!("trim boundary not recoverable");
+    }
+    Ok(())
+}
+
+/// The deviation a triangle touching the trim boundary may show: the largest
+/// sagitta of the boundary's own samples, the chord each saved sample pair
+/// makes against the surface at the middle of its UV span. Revit's boundary
+/// is drawn with that deviation, so a triangle along it is not held finer
+/// than the samples are; it is clamped to [`CHORD`, `DISPLAY_TOLERANCE`].
+/// Interior triangles keep [`CHORD`].
+fn boundary_tolerance(surface: &ParametricSurface, rings: &[&[Uv]]) -> Result<f64> {
+    let mut sagitta = 0_f64;
+    for ring in rings {
+        for k in 0..ring.len() {
+            let (a, b) = (ring[k], ring[(k + 1) % ring.len()]);
+            let (pa, pb) = (point3(surface, a)?, point3(surface, b)?);
+            let chord: [f64; 3] = std::array::from_fn(|i| (pa[i] + pb[i]) / 2.);
+            let mid = point3(surface, [(a[0] + b[0]) / 2., (a[1] + b[1]) / 2.])?;
+            sagitta = sagitta.max(distance(mid, chord));
+        }
+    }
+    Ok(sagitta.clamp(CHORD, DISPLAY_TOLERANCE))
+}
+
+/// Whether every triangle's surface stays within its tolerance of its linear
+/// mapping: [`CHORD`] for interior triangles, `boundary_tol` for those with a
+/// vertex among the first `boundary_count` (the trim samples, which are not
+/// refined).
+fn within_chord(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    boundary_count: usize,
+    boundary_tol: f64,
+) -> Result<bool> {
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(surface, p)).collect::<Result<_>>()?;
+    for &[a, b, c] in tris {
+        let tol = if [a, b, c].iter().any(|&k| (k as usize) < boundary_count) {
+            boundary_tol
+        } else {
+            CHORD
+        };
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        let (qa, qb, qc) = (verts3[a as usize], verts3[b as usize], verts3[c as usize]);
+        let samples = [
+            ([1. / 3., 1. / 3., 1. / 3.], [(pa[0] + pb[0] + pc[0]) / 3., (pa[1] + pb[1] + pc[1]) / 3.]),
+            ([0.5, 0.5, 0.], [(pa[0] + pb[0]) / 2., (pa[1] + pb[1]) / 2.]),
+            ([0., 0.5, 0.5], [(pb[0] + pc[0]) / 2., (pb[1] + pc[1]) / 2.]),
+            ([0.5, 0., 0.5], [(pa[0] + pc[0]) / 2., (pa[1] + pc[1]) / 2.]),
+        ];
+        for (w, s) in samples {
+            let true_point = point3(surface, s)?;
+            let linear: [f64; 3] = std::array::from_fn(|k| w[0] * qa[k] + w[1] * qb[k] + w[2] * qc[k]);
+            if distance(true_point, linear) > tol {
+                return Ok(false);
+            }
+        }
+    }
+    Ok(true)
+}
+
+/// The triangles whose surface leaves their linear mapping by more than the
+/// tolerance they are held to: [`CHORD`] for interior triangles, `boundary_tol`
+/// for those with a vertex among the first `boundary_count` (the trim samples,
+/// which are not refined).
+fn bad_triangles(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    boundary_count: usize,
+    boundary_tol: f64,
+    interior_tol: f64,
+) -> Result<Vec<usize>> {
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(surface, p)).collect::<Result<_>>()?;
+    let mut bad = Vec::new();
+    for (ti, &[a, b, c]) in tris.iter().enumerate() {
+        let tol = if [a, b, c].iter().any(|&k| (k as usize) < boundary_count) {
+            boundary_tol
+        } else {
+            interior_tol
+        };
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        let (qa, qb, qc) = (verts3[a as usize], verts3[b as usize], verts3[c as usize]);
+        let samples = [
+            ([1. / 3., 1. / 3., 1. / 3.], [(pa[0] + pb[0] + pc[0]) / 3., (pa[1] + pb[1] + pc[1]) / 3.]),
+            ([0.5, 0.5, 0.], [(pa[0] + pb[0]) / 2., (pa[1] + pb[1]) / 2.]),
+            ([0., 0.5, 0.5], [(pb[0] + pc[0]) / 2., (pb[1] + pc[1]) / 2.]),
+            ([0.5, 0., 0.5], [(pa[0] + pc[0]) / 2., (pa[1] + pc[1]) / 2.]),
+        ];
+        for (w, s) in samples {
+            let true_point = point3(surface, s)?;
+            let linear: [f64; 3] = std::array::from_fn(|k| w[0] * qa[k] + w[1] * qb[k] + w[2] * qc[k]);
+            if distance(true_point, linear) > tol {
+                bad.push(ti);
+                break;
+            }
+        }
+    }
+    Ok(bad)
+}
+
+/// Whether `e` is the budget refusal, which sends a face to the CDT.
+fn is_budget(e: &anyhow::Error) -> bool {
+    e.to_string() == "trimmed face exceeds its budget"
+}
+
+/// The lattice triangulation of a single-loop trim: the boundary samples
+/// triangulated by earcut, then interior lattice points at the coarsest
+/// division whose triangles all meet their chord tolerance. `None` when no
+/// division does, or the lattice runs over budget.
+fn lattice_mesh(
+    uv: &[Uv],
+    hole_starts: &[u32],
+    outer: &[Uv],
+    holes: &[Vec<Uv>],
+    surface: &ParametricSurface,
+    boundary_count: usize,
+    boundary_tol: f64,
+    expected: f64,
+) -> Result<Option<(Vec<Uv>, Vec<[u32; 3]>)>> {
+    let mut indices = Vec::<u32>::new();
+    earcut::Earcut::new().earcut(uv.iter().copied(), hole_starts, &mut indices);
+    ensure!(!indices.is_empty() && indices.len() % 3 == 0, "triangulation failed");
+    let mut tris: Vec<[u32; 3]> = Vec::new();
+    let mut sum = 0.;
+    for t in indices.chunks_exact(3) {
+        let t = [t[0], t[1], t[2]];
+        ensure!(t.iter().all(|&k| (k as usize) < uv.len()), "triangle bounds");
+        let a = cross2(uv[t[0] as usize], uv[t[1] as usize], uv[t[2] as usize]);
+        if a.abs() <= 1e-14 {
+            continue;
+        }
+        sum += a.abs() * 0.5;
+        tris.push(if a > 0. { t } else { [t[0], t[2], t[1]] });
+    }
+    ensure!(
+        (sum - expected).abs() <= 1e-7 * expected.max(1e-6),
+        "triangulated area mismatch"
+    );
+    // Interior points are added on a lattice, one containing triangle at a
+    // time, so every boundary sample and boundary edge stays as it is. The
+    // coarsest lattice whose triangles all stay within CHORD of the surface is
+    // taken.
+    let coarse_run = coarse();
+    let levels: &[usize] = if coarse_run { &[0] } else { &[0, 8, 16, 32, 64] };
+    for &divisions in levels {
+        let (points, tris) = match lattice_refine(outer, holes, uv, &tris, divisions) {
+            Ok(found) => found,
+            Err(e) if is_budget(&e) => return Ok(None),
+            Err(e) => return Err(e),
+        };
+        if coarse_run {
+            return Ok(Some((points, tris)));
+        }
+        let ok = within_chord(surface, &points, &tris, boundary_count, boundary_tol)?;
+        if ok {
+            return Ok(Some((points, tris)));
+        }
+    }
+    Ok(None)
+}
+
+/// The constrained Delaunay triangulation of the trim's boundary samples in
+/// UV, refined inside the trim until every triangle meets its tolerance. Only
+/// interior points are added: a candidate within `margin` of a trim edge is
+/// not, so a face that needs a boundary split is refused.
+fn cdt_mesh(
+    surface: &ParametricSurface,
+    rings: &[Vec<Uv>],
+    boundary: &[Uv],
+    boundary_edges: &BTreeSet<(u32, u32)>,
+    boundary_count: usize,
+    boundary_tol: f64,
+    expected: f64,
+) -> Result<(Vec<Uv>, Vec<[u32; 3]>)> {
+    work_reset();
+    let mut seen_samples = BTreeSet::new();
+    for p in boundary {
+        ensure!(
+            seen_samples.insert([p[0].to_bits(), p[1].to_bits()]),
+            "duplicate trim sample"
+        );
+    }
+    let constraints: Vec<(u32, u32)> = boundary_edges.iter().copied().collect();
+    let span = (0..2)
+        .map(|k| {
+            let lo = rings.iter().flatten().map(|p| p[k]).fold(f64::INFINITY, f64::min);
+            let hi = rings.iter().flatten().map(|p| p[k]).fold(f64::NEG_INFINITY, f64::max);
+            hi - lo
+        })
+        .fold(1e-9_f64, f64::max);
+    let gap2 = (1e-9 * span) * (1e-9 * span);
+    let new_rules = crate::research::native_parametric_surface::new_rules();
+    let margin = if new_rules { 1e-3 * span } else { 1e-6 * span };
+    let margin2 = margin * margin;
+    let mut points = boundary.to_vec();
+    // Points are binned in a GRID x GRID cell grid over the outer loop's box,
+    // as linked lists in Vec indices, so the duplicate test looks only at the
+    // nearby cells.
+    const GRID: usize = 64;
+    let origin: Uv = std::array::from_fn(|k| rings.iter().flatten().map(|p| p[k]).fold(f64::INFINITY, f64::min));
+    let cell_w = span / GRID as f64;
+    let cell_of = |p: Uv| -> usize {
+        let cx = (((p[0] - origin[0]) / cell_w).floor().max(0.) as usize).min(GRID - 1);
+        let cy = (((p[1] - origin[1]) / cell_w).floor().max(0.) as usize).min(GRID - 1);
+        cy * GRID + cx
+    };
+    let mut head = vec![u32::MAX; GRID * GRID];
+    let mut next: Vec<u32> = Vec::with_capacity(points.len() + 64);
+    for (i, &p) in points.iter().enumerate() {
+        let c = cell_of(p);
+        next.push(head[c]);
+        head[c] = i as u32;
+    }
+    let mut done = None;
+    let mut stuck: Option<(Uv, Uv)> = None;
+    let refine3d = REFINE_3D.load(std::sync::atomic::Ordering::Relaxed);
+    let interior_tol = if refine3d { boundary_tol } else { CHORD };
+    let max_rounds = if refine3d { REFINE_ROUNDS_3D } else { REFINE_ROUNDS };
+    let max_points = if refine3d { REFINE_POINTS_3D } else { REFINE_POINTS };
+    for round in 0..=max_rounds {
+        ensure!(points.len() < MAX_VERTICES, "trimmed face exceeds its budget");
+        work_add(points.len() + constraints.len());
+        ensure!(!work_over(), "third pass work budget exceeded");
+        let mut tris = delaunay(&points);
+        constrain(&points, &mut tris, &constraints)?;
+        tris.retain(|t| in_region(centroid(&points, *t), rings));
+        ensure!(tris.len() < MAX_TRIANGLES, "trimmed face exceeds its budget");
+        work_add(tris.len() * 3);
+        ensure!(!work_over(), "third pass work budget exceeded");
+        let bad = bad_triangles(surface, &points, &tris, boundary_count, boundary_tol, interior_tol)?;
+        if bad.is_empty() {
+            done = Some(tris);
+            break;
+        }
+        if round == max_rounds {
+            break;
+        }
+        ensure!(
+            points.len() - boundary_count + bad.len() <= max_points,
+            "trimmed face needs too many refinement points"
+        );
+        if new_rules {
+            stuck = chord_pair(surface, &points, &tris, &bad, boundary_count)?;
+        }
+        if refine3d {
+            // Longest 3D edge of each bad triangle that is not a trim
+            // constraint, bisected at its UV midpoint.
+            let mut added3 = false;
+            for ti in bad {
+                let t = tris[ti];
+                let mut best: Option<(f64, u32, u32)> = None;
+                for (a, b) in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+                    if boundary_edges.contains(&(a.min(b), a.max(b))) {
+                        continue;
+                    }
+                    let len = distance(
+                        point3(surface, points[a as usize])?,
+                        point3(surface, points[b as usize])?,
+                    );
+                    if best.is_none_or(|(l, _, _)| len > l) {
+                        best = Some((len, a, b));
+                    }
+                }
+                let Some((len, a, b)) = best else { continue };
+                if len <= MIN_EDGE {
+                    continue;
+                }
+                let (pa, pb) = (points[a as usize], points[b as usize]);
+                let p = [(pa[0] + pb[0]) / 2., (pa[1] + pb[1]) / 2.];
+                if !in_region(p, rings) {
+                    continue;
+                }
+                let c = cell_of(p);
+                let (cx, cy) = (c % GRID, c / GRID);
+                let mut duplicate = false;
+                for ny in cy.saturating_sub(1)..=(cy + 1).min(GRID - 1) {
+                    for nx in cx.saturating_sub(1)..=(cx + 1).min(GRID - 1) {
+                        let mut j = head[ny * GRID + nx];
+                        while j != u32::MAX {
+                            let q = points[j as usize];
+                            if (q[0] - p[0]).powi(2) + (q[1] - p[1]).powi(2) <= gap2 {
+                                duplicate = true;
+                            }
+                            j = next[j as usize];
+                        }
+                    }
+                }
+                if !duplicate {
+                    points.push(p);
+                    next.push(head[c]);
+                    head[c] = (points.len() - 1) as u32;
+                    added3 = true;
+                }
+            }
+            if !added3 {
+                break;
+            }
+            continue;
+        }
+        let mut added = false;
+        for ti in bad {
+            let t = tris[ti];
+            // Boundary samples cannot be split, so near a sharp trim corner a
+            // bad triangle may never meet its tolerance. Below MIN_EDGE it is
+            // left as it is, which keeps refinement finite.
+            let q: [[f64; 3]; 3] = [
+                point3(surface, points[t[0] as usize])?,
+                point3(surface, points[t[1] as usize])?,
+                point3(surface, points[t[2] as usize])?,
+            ];
+            if distance(q[0], q[1]).max(distance(q[1], q[2])).max(distance(q[2], q[0])) <= MIN_EDGE {
+                continue;
+            }
+            let [a, b, c] = t.map(|k| points[k as usize]);
+            let near_constraint = |p: Uv| {
+                constraints
+                    .iter()
+                    .any(|&(u, v)| segment_distance2(p, points[u as usize], points[v as usize]) <= margin2)
+            };
+            let mut p = circumcentre(a, b, c)
+                .filter(|p| in_region(*p, rings))
+                .unwrap_or_else(|| centroid(&points, t));
+            if near_constraint(p) {
+                // Under the round-6 rules a candidate within 1e-3 of the span
+                // of a trim constraint is not used: the centroid is tried, and
+                // a triangle whose centroid is also that close is left as it is.
+                if !new_rules {
+                    continue;
+                }
+                p = centroid(&points, t);
+                if near_constraint(p) {
+                    continue;
+                }
+            }
+            let c = cell_of(p);
+            let (cx, cy) = (c % GRID, c / GRID);
+            let mut duplicate = false;
+            for ny in cy.saturating_sub(1)..=(cy + 1).min(GRID - 1) {
+                for nx in cx.saturating_sub(1)..=(cx + 1).min(GRID - 1) {
+                    let mut j = head[ny * GRID + nx];
+                    while j != u32::MAX {
+                        let q = points[j as usize];
+                        if (q[0] - p[0]).powi(2) + (q[1] - p[1]).powi(2) <= gap2 {
+                            duplicate = true;
+                        }
+                        j = next[j as usize];
+                    }
+                }
+            }
+            if !duplicate {
+                points.push(p);
+                next.push(head[c]);
+                head[c] = (points.len() - 1) as u32;
+                added = true;
+            }
+        }
+        if !added {
+            break;
+        }
+    }
+    let done = match done {
+        Some(done) => done,
+        None => match stuck {
+            Some((a, b)) => return Err(anyhow::Error::new(ChordEdge { a, b })),
+            None => bail!("trimmed face needs a finer triangulation"),
+        },
+    };
+    let sum: f64 = done
+        .iter()
+        .map(|t| cross2(points[t[0] as usize], points[t[1] as usize], points[t[2] as usize]).abs() * 0.5)
+        .sum();
+    ensure!(
+        (sum - expected).abs() <= 1e-7 * expected.max(1e-6),
+        "triangulated area mismatch"
+    );
+    Ok((points, done))
+}
+
+/// A point in model space.
+type Point = [f64; 3];
+
+thread_local! {
+    /// Shared trim edges (by edge object index) that take extra 3D points,
+    /// set only while the round-8 retry of one geometry object runs.
+    static SPLITS: std::cell::RefCell<BTreeMap<usize, Vec<Point>>> =
+        std::cell::RefCell::new(BTreeMap::new());
+    /// Whether any edge carries a split point (a cheap test for the loops).
+    static SPLIT_ACTIVE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// The (face, edge) pairs whose boundary took a split point.
+    static CONSUMED: std::cell::RefCell<BTreeSet<(usize, usize)>> =
+        std::cell::RefCell::new(BTreeSet::new());
+}
+
+/// A boundary chord that the triangulation cannot meet within tolerance,
+/// with its two trim samples in UV. Its edge can be split in 3D.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ChordEdge {
+    pub(crate) a: Uv,
+    pub(crate) b: Uv,
+}
+
+impl std::fmt::Display for ChordEdge {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("trimmed face needs a finer triangulation")
+    }
+}
+
+impl std::error::Error for ChordEdge {}
+
+/// The longest boundary chord of a bad triangle.
+fn chord_pair(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    bad: &[usize],
+    boundary_count: usize,
+) -> Result<Option<(Uv, Uv)>> {
+    let mut best: Option<(f64, Uv, Uv)> = None;
+    for &ti in bad {
+        let t = tris[ti];
+        for k in 0..3 {
+            let (u, v) = (t[k], t[(k + 1) % 3]);
+            if u as usize >= boundary_count || v as usize >= boundary_count {
+                continue;
+            }
+            let len = distance(point3(surface, uv[u as usize])?, point3(surface, uv[v as usize])?);
+            if best.map_or(true, |b| len > b.0) {
+                best = Some((len, uv[u as usize], uv[v as usize]));
+            }
+        }
+    }
+    Ok(best.map(|(_, a, b)| (a, b)))
+}
+
+/// The point of `surface` nearest to `p`: a grid start, then Gauss-Newton on
+/// the (u, v) parameters, clamped to the surface's bounds.
+pub(crate) fn nearest_uv(surface: &ParametricSurface, p: Point) -> Result<Uv> {
+    let [[u0, v0], [u1, v1]] = surface.bounds();
+    let n = 24;
+    let mut best = (f64::INFINITY, [u0, v0]);
+    for i in 0..=n {
+        for j in 0..=n {
+            let uv = [
+                u0 + (u1 - u0) * i as f64 / n as f64,
+                v0 + (v1 - v0) * j as f64 / n as f64,
+            ];
+            if let Ok(q) = surface.evaluate(uv[0], uv[1]) {
+                let d = distance(q, p);
+                if d < best.0 {
+                    best = (d, uv);
+                }
+            }
+        }
+    }
+    let mut uv = best.1;
+    let sub = |a: Point, b: Point| [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
+    let dot = |a: Point, b: Point| a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+    for _ in 0..60 {
+        let q = surface.evaluate(uv[0], uv[1])?;
+        let r = sub(q, p);
+        let (up, um) = ((uv[0] + (u1 - u0) * 1e-7).min(u1), (uv[0] - (u1 - u0) * 1e-7).max(u0));
+        let (vp, vm) = ((uv[1] + (v1 - v0) * 1e-7).min(v1), (uv[1] - (v1 - v0) * 1e-7).max(v0));
+        let qu = sub(surface.evaluate(up, uv[1])?, surface.evaluate(um, uv[1])?);
+        let qv = sub(surface.evaluate(uv[0], vp)?, surface.evaluate(uv[0], vm)?);
+        let du: Point = std::array::from_fn(|k| qu[k] / (up - um).max(1e-300));
+        let dv: Point = std::array::from_fn(|k| qv[k] / (vp - vm).max(1e-300));
+        let (a11, a12, a22) = (dot(du, du), dot(du, dv), dot(dv, dv));
+        let (b1, b2) = (-dot(du, r), -dot(dv, r));
+        let det = a11 * a22 - a12 * a12;
+        if det.abs() < 1e-300 {
+            break;
+        }
+        let d0 = (b1 * a22 - b2 * a12) / det;
+        let d1 = (a11 * b2 - a12 * b1) / det;
+        uv[0] = (uv[0] + d0).clamp(u0, u1);
+        uv[1] = (uv[1] + d1).clamp(v0, v1);
+        if d0.abs() + d1.abs() < 1e-13 {
+            break;
+        }
+    }
+    Ok(uv)
+}
+
+/// A point on both surfaces near `uv` of `si`: alternating nearest-point
+/// projections, which converge onto the surfaces' intersection, the shared
+/// trim edge when the two faces meet along it.
+fn edge_point(si: &ParametricSurface, sj: &ParametricSurface, uv: Uv) -> Result<Point> {
+    let mut p = si.evaluate(uv[0], uv[1])?;
+    for _ in 0..60 {
+        let uj = nearest_uv(sj, p)?;
+        let q = sj.evaluate(uj[0], uj[1])?;
+        let ui = nearest_uv(si, q)?;
+        let p2 = si.evaluate(ui[0], ui[1])?;
+        let gap = distance(p2, q);
+        p = p2;
+        if gap < 1e-9 {
+            return Ok(std::array::from_fn(|k| 0.5 * (p2[k] + q[k])));
+        }
+        bail!("shared edge point did not converge")
+}
+    bail!("shared edge point did not converge")
+}
