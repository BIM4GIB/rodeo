+/// Whether a decode stopped at the trimmed-face refinement cap.
+fn refinement_cap_failure(diagnostics: &[String]) -> bool {
+    diagnostics
+        .iter()
+        .any(|d| d.contains("trimmed face needs too many refinement points"))
+}
