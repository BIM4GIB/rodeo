+        },
+    ) = (profile1, profile2)
+    {
+        let da = std::array::from_fn(|k| a[k] * (ra[1] - ra[0]));
+        let db = std::array::from_fn(|k| b[k] * (rb[1] - rb[0]));
+        let mixed = length3(std::array::from_fn(|k| da[k] - db[k]));
+        return Ok((mixed / CHORD)
+            .sqrt()
+            .ceil()
+            .max(length3(da).ceil())
+            .max(length3(db).ceil()));
+    }
+    let mut n = 1.0_f64;
+    for profile in [profile1, profile2] {
