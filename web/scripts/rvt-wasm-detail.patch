+        } => !(matches!(profile1, Curve::Line { .. }) && matches!(profile2, Curve::Line { .. })),
+        ParametricSurface::SurfRev { profile, .. } => {
+            matches!(profile, Curve::Ellipse { .. } | Curve::Hermite { .. })
+        }
