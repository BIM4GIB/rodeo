+/// Adds `own`'s counts to `report`.
+fn absorb(report: &mut SavedMeshReport, own: &SavedMeshReport) {
+    report.replaced += own.replaced;
+    report.partial += own.partial;
+    report.partial_admitted += own.partial_admitted;
+    report.triangles += own.triangles;
+}
