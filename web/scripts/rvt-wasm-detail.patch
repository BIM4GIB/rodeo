+/// Whether every decoder failure of an element is one no pass can decode.
+fn third_unfixable(diagnostics: &[String]) -> bool {
+    !diagnostics.is_empty()
+        && diagnostics.iter().all(|d| {
+            d.contains("instance target restrictions are unsupported")
+                || d.contains("unsupported reachable graphics class GGTag")
+        })
+}
