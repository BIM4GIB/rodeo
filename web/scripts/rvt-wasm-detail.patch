+//! Parametric faces whose saved trim is not a UV rectangle. Each trim loop is
+//! read as a UV polygon. A single-loop trim is triangulated in UV by its
+//! boundary samples, which are the samples neighbouring faces share, and the
+//! triangles are split at their centroids until the surface stays within
+//! [`CHORD`] of its linear mapping: the interior lattice. Where that lattice
+//! refuses, and for a face with holes, the outer loop and its holes are
+//! triangulated by a constrained Delaunay triangulation in UV, refined with
+//! interior points only, so every boundary edge stays as the samples left it.
+//! Anything else is refused and the element keeps its record box.
+
+use crate::native_parameters::ObjectGraph;
+use crate::native_parametric_mesh::{
+    CHORD, DISPLAY_TOLERANCE, SHARED_EDGE_TOLERANCE, VISUAL, shared_edge_error,
+};
+use crate::native_parametric_surface::ParametricSurface;
+use crate::native_saved_mesh::{FaceMesh, pointer};
+use crate::vector_math::distance;
+use anyhow::{Context, Result, bail, ensure};
+use std::cell::RefCell;
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+
+/// The most vertices one trimmed face may build.
+const MAX_VERTICES: usize = 200_000;
+/// The most triangles one trimmed face may build.
+const MAX_TRIANGLES: usize = 400_000;
+/// The most refinement rounds one trimmed face may take in the CDT.
+const REFINE_ROUNDS: usize = 16;
+/// The shortest 3D edge a CDT refinement point is still added inside, in feet.
+const MIN_EDGE: f64 = 0.01;
+/// The most interior CDT refinement points one trimmed face may add. Each
+/// round rebuilds the triangulation, so the cost grows with this count.
+const REFINE_POINTS: usize = 1200;
+/// Rounds and interior points for the 3D-metric retry ([`REFINE_3D`]).
+const REFINE_ROUNDS_3D: usize = 60;
+const REFINE_POINTS_3D: usize = 30000;
+/// Set only for the retry of a face whose first decode failed with "too many
+/// refinement points": the insertion splits the longest 3D edge, the
+/// interior test uses the boundary chord, and the caps above apply.
+pub static REFINE_3D: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// Deterministic work budget for one trimmed face's mesh, counted per
+/// refinement round in points and triangles processed. u64::MAX is no budget.
+pub static WORK_BUDGET: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(u64::MAX);
+static WORK: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+thread_local! {
+    static COARSE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+/// Whether this thread is meshing a coarse pre-check body (round 24): the
+/// lattice takes only its coarsest level, with no chord test.
+pub(crate) fn coarse() -> bool {
+    COARSE.with(|c| c.get())
+}
+/// Run `f` with the coarse pre-check meshing on this thread.
+pub(crate) fn with_coarse<T>(f: impl FnOnce() -> T) -> T {
+    COARSE.with(|c| c.set(true));
+    let out = f();
+    COARSE.with(|c| c.set(false));
+    out
+}
+fn work_reset() {
+    WORK.store(0, std::sync::atomic::Ordering::Relaxed);
+}
+fn work_add(n: usize) {
+    WORK.fetch_add(n as u64, std::sync::atomic::Ordering::Relaxed);
+}
+fn work_over() -> bool {
+    WORK.load(std::sync::atomic::Ordering::Relaxed) > WORK_BUDGET.load(std::sync::atomic::Ordering::Relaxed)
+}
+/// The error text the rectangular grid gives a non-rectangular trim.
+pub(crate) const NONRECTANGULAR: &str = "nonrectangular parametric trim";
+
+type Uv = [f64; 2];
+
+/// Whether `fi`'s rectangular grid refuses only because its trim is not a
+/// UV rectangle, so that this module draws it instead.
+pub(crate) fn is_trimmed_fallback(g: &ObjectGraph, fi: usize) -> bool {
+    match crate::native_parametric_mesh::face_grid(g, fi) {
+        Ok(_) => false,
+        Err(e) => e.to_string() == NONRECTANGULAR,
+    }
+}
+
+fn point3(surface: &ParametricSurface, uv: Uv) -> Result<[f64; 3]> {
+    surface.evaluate(uv[0], uv[1])
+}
+
+/// The UV samples of one trim loop's edges, in loop order, each edge read on
+/// the side of `fi`.
+fn loop_segments(g: &ObjectGraph, fi: usize, li: usize, surface: &ParametricSurface) -> Result<Vec<Vec<Uv>>> {
+    let l = &g.objects[li];
+    ensure!(
+        ["EdgeLoop", "EdgeLoopWithChainEnvelopes"].contains(&l.class_name.as_str()),
+        "unsupported trim loop"
+    );
+    ensure!(l.fields["m_open"] == false, "open trim loop");
+    ensure!(
+        pointer(g, li, &l.fields["m_pFace"])? == Some(fi),
+        "loop owner mismatch"
+    );
+    let mut cur = pointer(g, li, &l.fields["m_next"])?.context("empty trim")?;
+    let mut seen = BTreeSet::new();
+    let mut segments = Vec::new();
+    while cur != li {
+        ensure!(seen.insert(cur), "trim edge cycle");
+        let e = &g.objects[cur];
+        ensure!(e.class_name == "Edge", "nonedge trim member");
+        let faces = e.fields["m_pFace"].as_array().context("edge face pair")?;
+        ensure!(faces.len() == 2, "edge face pair length");
+        let mut side = None;
+        for (i, p) in faces.iter().enumerate() {
+            if pointer(g, cur, p)? == Some(fi) {
+                ensure!(side.is_none(), "ambiguous face side");
+                side = Some(i);
+            }
+        }
+        let side = side.context("edge does not belong to face")?;
+        let ends = e.fields["m_firstAndLastEdgePnts"]
+            .as_array()
+            .context("edge endpoints")?;
+        ensure!(ends.len() == 2, "edge endpoint count");
+        let uv = |v: &serde_json::Value| -> Result<Uv> {
+            let a = v.as_array().context("UV array")?;
+            ensure!(a.len() == 2, "UV dimension");
+            let p = [
+                a[0].as_f64().context("UV number")?,
+                a[1].as_f64().context("UV number")?,
+            ];
+            ensure!(p.iter().all(|x| x.is_finite()), "nonfinite UV");
+            Ok(p)
+        };
+        let mut points = vec![uv(&ends[0]["uv"][side])?];
+        for p in e.fields["m_interiorEdgePnts"]
+            .as_array()
+            .context("edge interior points")?
+        {
+            points.push(uv(&p["uv"][side])?);
+        }
+        points.push(uv(&ends[1]["uv"][side])?);
+        let points = apply_splits(cur, fi, surface, points, true)?;
+        segments.push(points);
+        cur = pointer(g, cur, &e.fields["m_next"][side])?.context("null trim next")?;
+    }
+    ensure!(!segments.is_empty(), "too few parametric edges");
+    Ok(segments)
+}
+
+/// Joins a loop's edge samples into one closed UV ring, end to end in 3D.
+/// Round-11 third pass: a RuledSurf trim ring whose consecutive points differ
+/// in both UV coordinates is closed by a false diagonal across the face where
+/// a side of the envelope is collapsed (its profile is a point, so the side
+/// has no 3D length). Such a step is replaced by the two-leg path through the
+/// envelope corner that is shorter in 3D, which runs along the collapsed side
+/// at no 3D cost. Zero-length steps (UV duplicates) are dropped first.
+fn close_through_collapsed(surface: &ParametricSurface, ring: Vec<Uv>) -> Result<Vec<Uv>> {
+    // Every boundary sample is kept (a neighbour face may use it). Only exact
+    // duplicates of a 3D point are dropped, and only envelope corners are
+    // added, to close a false diagonal through a collapsed side.
+    let mut kept: Vec<Uv> = Vec::with_capacity(ring.len());
+    let mut kept3: Vec<Point> = Vec::with_capacity(ring.len());
+    for p in ring {
+        let p3 = point3(surface, p)?;
+        if let Some(last) = kept3.last() {
+            if distance(*last, p3) < 1e-9 {
+                continue;
+            }
+        }
+        kept.push(p);
+        kept3.push(p3);
+    }
+    let mut ring = kept;
+    let env = surface.bounds();
+    let on_env = |p: Uv| {
+        (p[0] - env[0][0]).abs() < 1e-9
+            || (p[0] - env[1][0]).abs() < 1e-9
+            || (p[1] - env[0][1]).abs() < 1e-9
+            || (p[1] - env[1][1]).abs() < 1e-9
+    };
+    let n = ring.len();
+    let mut out: Vec<Uv> = Vec::with_capacity(n + 4);
+    for k in 0..n {
+        let a = ring[k];
+        let b = ring[(k + 1) % n];
+        out.push(a);
+        let diagonal = (a[0] - b[0]).abs() > 1e-9 && (a[1] - b[1]).abs() > 1e-9;
+        if diagonal && on_env(a) && on_env(b) {
+            let c1: Uv = [b[0], a[1]];
+            let c2: Uv = [a[0], b[1]];
+            let len = |c: Uv| -> Result<f64> {
+                Ok(distance(point3(surface, a)?, point3(surface, c)?) + distance(point3(surface, c)?, point3(surface, b)?))
+            };
+            let pick = if len(c1)? <= len(c2)? { c1 } else { c2 };
+            out.push(pick);
+        }
+    }
+    Ok(out)
+}
+
+fn closed_ring(surface: &ParametricSurface, segments: Vec<Vec<Uv>>) -> Result<Vec<Uv>> {
+    let env = surface.bounds();
+    let segments = segments
+        .into_iter()
+        .map(|seg| {
+            seg.into_iter()
+                .map(|p| {
+                    for k in 0..2 {
+                        ensure!(
+                            p[k] >= env[0][k] - 1e-7 && p[k] <= env[1][k] + 1e-7,
+                            "trim outside surface envelope"
+                        );
+                    }
+                    Ok([p[0].clamp(env[0][0], env[1][0]), p[1].clamp(env[0][1], env[1][1])])
+                })
+                .collect::<Result<Vec<_>>>()
+        })
+        .collect::<Result<Vec<_>>>()?;
+    // Corners join within 1e-7 of each other in 3D; failing every ordering
+    // that way, within VISUAL.
+    for tolerance in [1e-7, VISUAL] {
+        for reverse in [false, true] {
+            let mut ring: Vec<Uv> = segments[0].clone();
+            if reverse {
+                ring.reverse();
+            }
+            let mut valid = true;
+            for seg in &segments[1..] {
+                let last = point3(surface, *ring.last().context("empty ring")?)?;
+                let a = seg[0];
+                let b = *seg.last().context("empty segment")?;
+                if distance(last, point3(surface, a)?) < tolerance {
+                    ring.extend_from_slice(&seg[1..]);
+                } else if distance(last, point3(surface, b)?) < tolerance {
+                    ring.extend(seg.iter().rev().skip(1).copied());
+                } else {
+                    valid = false;
+                    break;
+                }
+            }
+            if valid
+                && distance(
+                    point3(surface, ring[0])?,
+                    point3(surface, *ring.last().context("empty ring")?)?,
+                ) < tolerance
+            {
+                ring.pop();
+                ring.dedup_by(|a, b| (a[0] - b[0]).abs() < 1e-12 && (a[1] - b[1]).abs() < 1e-12);
+                while ring.len() > 1 {
+                    let (first, last) = (ring[0], *ring.last().unwrap());
+                    if (first[0] - last[0]).abs() < 1e-12 && (first[1] - last[1]).abs() < 1e-12 {
+                        ring.pop();
+                    } else {
+                        break;
+                    }
+                }
