+        x: plane_vec(&s.fields["m_xVec"])?,
+        y: plane_vec(&s.fields["m_yVec"])?,
+    })
+}
+
+/// The (a, b) of the plane point nearest `p`: p ~ origin + a x + b y, by the
+/// Gram system, so non-orthogonal axes are handled.
+fn plane_uv_of(plane: &PlaneFrame, p: Point) -> Uv {
+    let d: Point = std::array::from_fn(|k| p[k] - plane.origin[k]);
+    let dot = |a: Point, b: Point| (0..3).map(|k| a[k] * b[k]).sum::<f64>();
+    let (xx, xy, yy) = (dot(plane.x, plane.x), dot(plane.x, plane.y), dot(plane.y, plane.y));
+    let (rx, ry) = (dot(d, plane.x), dot(d, plane.y));
+    let det = xx * yy - xy * xy;
+    [(rx * yy - ry * xy) / det, (ry * xx - rx * xy) / det]
+}
+
+fn plane_point(plane: &PlaneFrame, uv: Uv) -> Point {
+    std::array::from_fn(|k| plane.origin[k] + uv[0] * plane.x[k] + uv[1] * plane.y[k])
+}
+
+/// The point where the curved surface meets the plane near `mid`, by
+/// alternating projection; None if it does not converge.
+fn plane_edge_point(surf: &ParametricSurface, plane: &PlaneFrame, mid: Uv) -> Result<Option<Point>> {
+    let mut p = surf.evaluate(mid[0], mid[1])?;
+    for _ in 0..60 {
+        let q = plane_point(plane, plane_uv_of(plane, p));
+        let ui = nearest_uv(surf, q)?;
+        let p2 = surf.evaluate(ui[0], ui[1])?;
+        let gap = distance(p2, q);
+        p = p2;
+        if gap < 1e-9 {
+            return Ok(Some(std::array::from_fn(|k| 0.5 * (p2[k] + q[k]))));
+        }
+    }
+    Ok(None)
+}
+
+/// The plane-side split hook (round-11 third pass): a Plane ring's edge
+/// samples with the splits planned for that edge, at their plane UV.
+pub(crate) fn plane_splits(e: usize, fi: usize, plane: &PlaneFrame, mut points: Vec<Uv>) -> Result<Vec<Uv>> {
+    if !SPLIT_ACTIVE.with(|c| c.get()) {
+        return Ok(points);
+    }
+    let extra = SPLITS.with(|s| s.borrow().get(&e).cloned().unwrap_or_default());
+    if extra.is_empty() || points.len() < 2 {
+        return Ok(points);
+    }
+    CONSUMED.with(|c| c.borrow_mut().insert((fi, e)));
+    for p3 in extra {
+        let uv = plane_uv_of(plane, p3);
+        if points
+            .iter()
+            .any(|q| (q[0] - uv[0]).abs() < 1e-9 && (q[1] - uv[1]).abs() < 1e-9)
+        {
+            continue;
+        }
+        let mut best = (f64::INFINITY, 0usize);
+        for k in 0..points.len() - 1 {
+            let d = segment_distance(uv, points[k], points[k + 1]);
+            if d < best.0 {
+                best = (d, k);
+            }
+        }
+        points.insert(best.1 + 1, uv);
+    }
+    Ok(points)
+}
+
+/// The curved-side split hook (round-11 third pass): a curved face's edge
+/// samples with the splits planned for that edge, at their UV on .
+pub(crate) fn curved_splits(e: usize, fi: usize, surface: &ParametricSurface, points: Vec<Uv>) -> Result<Vec<Uv>> {
+    apply_splits(e, fi, surface, points, true)
+}
+
+fn apply_splits(
+    e: usize,
+    fi: usize,
+    surface: &ParametricSurface,
+    mut points: Vec<Uv>,
+    record: bool,
+) -> Result<Vec<Uv>> {
+    if !SPLIT_ACTIVE.with(|c| c.get()) {
+        return Ok(points);
+    }
+    let extra = SPLITS.with(|s| s.borrow().get(&e).cloned().unwrap_or_default());
+    if extra.is_empty() || points.len() < 2 {
+        return Ok(points);
+    }
+    if record {
+        CONSUMED.with(|c| c.borrow_mut().insert((fi, e)));
+    }
+    for p3 in extra {
+        let uv = nearest_uv(surface, p3)?;
+        if points
+            .iter()
+            .any(|q| (q[0] - uv[0]).abs() < 1e-9 && (q[1] - uv[1]).abs() < 1e-9)
+        {
+            continue;
+        }
+        let mut best = (f64::INFINITY, 0usize);
+        for k in 0..points.len() - 1 {
+            let d = segment_distance(uv, points[k], points[k + 1]);
+            if d < best.0 {
+                best = (d, k);
+            }
+        }
+        points.insert(best.1 + 1, uv);
+    }
+    Ok(points)
+}
+
+/// Round-11 third pass: the constrained Delaunay triangulation of a planar
+/// face with holes, over its loop samples. Every loop edge is a constraint,
+/// triangles outside the face (even-odd over the loops) are dropped, and no
+/// point is added on a boundary. `segs` holds (start, len) of each loop in `pts`.
+fn plane_loop_triangles_grid(pts: &[Uv], segs: &[(usize, usize)]) -> Result<Vec<u32>> {
+    work_reset();
+    let rings: Vec<Vec<Uv>> = segs.iter().map(|&(s, n)| pts[s..s + n].to_vec()).collect();
+    let mut constraints = Vec::new();
+    for &(s, n) in segs {
+        for k in 0..n {
+            let a = (s + k) as u32;
+            let b = (s + (k + 1) % n) as u32;
+            constraints.push((a.min(b), a.max(b)));
+        }
+    }
+    constraints.sort_unstable();
+    constraints.dedup();
+    work_add(pts.len() + constraints.len());
+    ensure!(!work_over(), "third pass work budget exceeded");
+    let mut tris = delaunay(pts);
+    constrain(pts, &mut tris, &constraints)?;
+    // Third pass (exact grid): every triangle must keep a positive exact
+    // orientation. A triangulation that folds (a cavity insert can do it) is
+    // refused, and the face with it.
+    ensure!(
+        tris.iter().all(|t| cross2(pts[t[0] as usize], pts[t[1] as usize], pts[t[2] as usize]) > 0.),
+        "planar hole triangulation folds over (inverted triangle)"
+    );
+    tris.retain(|t| in_region(centroid(pts, *t), &rings));
+    ensure!(!tris.is_empty(), "planar hole triangulation is empty");
+    Ok(tris.into_iter().flatten().collect())
+}
+
+/// Round-11 third pass: the loop triangulation of a planar face with holes,
+/// on an integer grid of 2^36 steps over the face's UV span, where the
+/// orientation tests are exact. Samples that land on one grid point are
+/// merged (the first kept); a loop's repeated points are dropped.
+pub(crate) fn plane_loop_triangles(pts: &[Uv], segs: &[(usize, usize)]) -> Result<Vec<u32>> {
+    let mut lo = [f64::INFINITY; 2];
+    let mut hi = [f64::NEG_INFINITY; 2];
+    for &(s, n) in segs {
+        for p in &pts[s..s + n] {
+            for k in 0..2 {
+                lo[k] = lo[k].min(p[k]);
+                hi[k] = hi[k].max(p[k]);
+            }
+        }
+    }
+    let span = (hi[0] - lo[0]).max(hi[1] - lo[1]);
+    ensure!(span > 0. && span.is_finite(), "degenerate planar hole span");
+    // 2^15 steps over the span (about 8e-5 ft per step for a 2.6 ft face): the
+    // exact i128 in_circle needs its 4th-degree product to fit.
+    let scale = (1u64 << 15) as f64 / span;
+    let mut grid_index: BTreeMap<(i64, i64), u32> = BTreeMap::new();
+    let mut new_pts: Vec<Uv> = Vec::new();
+    let mut rep: Vec<u32> = Vec::new();
+    let mut map_point = |i: usize| -> u32 {
+        let p = pts[i];
+        let g = [((p[0] - lo[0]) * scale).round() as i64, ((p[1] - lo[1]) * scale).round() as i64];
+        *grid_index.entry((g[0], g[1])).or_insert_with(|| {
+            new_pts.push([g[0] as f64, g[1] as f64]);
+            rep.push(i as u32);
+            (new_pts.len() - 1) as u32
+        })
+    };
+    let mut new_segs = Vec::new();
+    for &(s, n) in segs {
+        let mut idx: Vec<u32> = Vec::new();
+        for k in 0..n {
+            let g = map_point(s + k);
+            if idx.last() != Some(&g) {
+                idx.push(g);
+            }
+        }
+        while idx.len() > 1 && idx.first() == idx.last() {
+            idx.pop();
+        }
+        ensure!(idx.len() >= 3, "planar hole loop collapsed on the grid");
+        new_segs.push((idx, ));
+    }
+    // Loops become contiguous runs of the merged point list.
+    let mut flat: Vec<u32> = Vec::new();
+    let mut ranges = Vec::new();
+    for (idx,) in &new_segs {
+        ranges.push((flat.len(), idx.len()));
+        flat.extend_from_slice(idx);
+    }
+    let pts_grid: Vec<Uv> = new_pts.clone();
+    let ordered: Vec<Uv> = flat.iter().map(|&g| pts_grid[g as usize]).collect();
+    // Renumber so each loop is contiguous in the new point array.
+    let mut renum: Vec<Uv> = Vec::new();
+    let mut back: Vec<u32> = Vec::new();
+    let mut seg2 = Vec::new();
+    for &(start, len) in &ranges {
+        seg2.push((renum.len(), len));
+        for k in 0..len {
+            renum.push(ordered[start + k]);
+            back.push(rep[flat[start + k] as usize]);
+        }
+    }
+    EXACT_ORIENT.with(|c| c.set(true));
+    let result = plane_loop_triangles_grid(&renum, &seg2);
+    EXACT_ORIENT.with(|c| c.set(false));
+    let tris = result?;
+    Ok(tris.into_iter().map(|t| back[t as usize]).collect())
+}
+
+
+/// Clears the shared split table and the consumed record.
+pub(crate) fn splits_clear() {
+    SPLIT_ACTIVE.with(|c| c.set(false));
+    SPLITS.with(|s| s.borrow_mut().clear());
+    CONSUMED.with(|c| c.borrow_mut().clear());
+}
+
+/// Forgets which faces consumed a split, before a round of meshing.
+pub(crate) fn consumed_clear() {
+    CONSUMED.with(|c| c.borrow_mut().clear());
+}
+
+/// Whether face `fi` took the splits of edge `e` in the last round.
+pub(crate) fn consumed(fi: usize, e: usize) -> bool {
+    CONSUMED.with(|c| c.borrow().contains(&(fi, e)))
+}
+
+/// The edges that carry split points.
+pub(crate) fn split_edges() -> Vec<usize> {
+    SPLITS.with(|s| s.borrow().keys().copied().collect())
+}
+
+/// Adds the split point `p` to edge `e`; false when it is already there.
+pub(crate) fn split_add(e: usize, p: Point) -> bool {
+    SPLIT_ACTIVE.with(|c| c.set(true));
+    SPLITS.with(|s| {
+        let mut m = s.borrow_mut();
+        let list = m.entry(e).or_default();
+        if list.iter().any(|q| distance(*q, p) < 1e-9) {
+            return false;
+        }
+        list.push(p);
+        true
+    })
+}
+
+/// The raw UV samples of edge `e` on side `side`: its two ends and interior.
+fn edge_uv_raw(g: &ObjectGraph, e: usize, side: usize) -> Result<Vec<Uv>> {
+    let edge = &g.objects[e];
+    let ends = edge.fields["m_firstAndLastEdgePnts"]
+        .as_array()
+        .context("edge endpoints")?;
+    ensure!(ends.len() == 2, "edge endpoint count");
+    let uv = |v: &serde_json::Value| -> Result<Uv> {
+        let a = v.as_array().context("UV array")?;
+        ensure!(a.len() == 2, "UV dimension");
+        Ok([
+            a[0].as_f64().context("UV number")?,
+            a[1].as_f64().context("UV number")?,
+        ])
+    };
+    let mut points = vec![uv(&ends[0]["uv"][side])?];
+    for p in edge
+        .fields["m_interiorEdgePnts"]
+        .as_array()
+        .context("edge interior points")?
+    {
+        points.push(uv(&p["uv"][side])?);
+    }
+    points.push(uv(&ends[1]["uv"][side])?);
+    Ok(points)
+}
+
+/// Plans the 3D split of the boundary chord `ce` of face `fi`: a point on the
+/// shared trim edge that the chord crosses, found on both faces' surfaces.
+/// `None` when the chord's edge has no second trimmed face to match.
+pub(crate) fn plan_split(g: &ObjectGraph, fi: usize, ce: &ChordEdge) -> Result<Option<(usize, Point)>> {
+    let f = &g.objects[fi];
+    let si = pointer(g, fi, &f.fields["m_pSurf"])?.context("face surface")?;
+    let surf_i = ParametricSurface::read(g, si)?;
+    let mut found: Option<(usize, Uv, Uv)> = None;
+    let mut next = pointer(g, fi, &f.fields["m_pFirstLoop"])?;
+    let mut loops = BTreeSet::new();
+    while let Some(li) = next {
+        ensure!(loops.insert(li), "loop-list cycle");
+        let l = &g.objects[li];
+        let mut cur = pointer(g, li, &l.fields["m_next"])?.context("empty trim")?;
+        let mut guard = BTreeSet::new();
+        while cur != li {
+            ensure!(guard.insert(cur), "trim edge cycle");
+            let e = &g.objects[cur];
+            let faces = e.fields["m_pFace"].as_array().context("edge face pair")?;
+            let mut side = None;
+            for (i, p) in faces.iter().enumerate() {
+                if pointer(g, cur, p)? == Some(fi) {
+                    side = Some(i);
+                }
+            }
+            let side = side.context("edge does not belong to face")?;
+            if found.is_none() {
+                let points = edge_uv_raw(g, cur, side)?;
+                let points = apply_splits(cur, fi, &surf_i, points, false)?;
+                // Samples match by UV or by 3D position: a degenerate end of
+                // a ruled surface gives two UVs for one point.
+                let mut same = |x: Uv, y: Uv| -> Result<bool> {
+                    if (x[0] - y[0]).abs() < 1e-9 && (x[1] - y[1]).abs() < 1e-9 {
+                        return Ok(true);
+                    }
+                    Ok(distance(point3(&surf_i, x)?, point3(&surf_i, y)?) < 1e-7)
+                };
+                for k in 0..points.len().saturating_sub(1) {
+                    let forward = same(points[k], ce.a)? && same(points[k + 1], ce.b)?;
+                    let backward = same(points[k], ce.b)? && same(points[k + 1], ce.a)?;
+                    if forward || backward {
+                        found = Some((cur, points[k], points[k + 1]));
+                        break;
+                    }
+                }
+            }
+            cur = pointer(g, cur, &e.fields["m_next"][side])?.context("null trim next")?;
+        }
+        next = pointer(g, li, &l.fields["m_nextLoop"])?;
+    }
+    let Some((e, seg_a, seg_b)) = found else {
+        return Ok(None);
+    };
+    let faces = g.objects[e].fields["m_pFace"].as_array().context("edge face pair")?;
+    let mut other = None;
+    for p in faces {
+        if let Some(x) = pointer(g, e, p)? {
+            if x != fi {
+                other = Some(x);
+            }
+        }
+    }
+    let Some(fj) = other else {
+        return Ok(None);
+    };
+    let Some(sj_index) = pointer(g, fj, &g.objects[fj].fields["m_pSurf"])? else {
+        return Ok(None);
+    };
+    let mid = [(seg_a[0] + seg_b[0]) / 2., (seg_a[1] + seg_b[1]) / 2.];
+    let surf_j = match ParametricSurface::read(g, sj_index) {
+        Ok(surf_j) => surf_j,
+        Err(_) => {
+            // Round-11 third pass: a Plane partner is intersected through its
+            // own frame, so both sides of a curved/plane edge can take the split.
+            if !crate::research::native_parametric_surface::third_rules()
+                || g.objects[sj_index].class_name != "Plane"
+            {
+                return Ok(None);
+            }
+            let plane = plane_frame(g, sj_index)?;
+            let Some(p) = plane_edge_point(&surf_i, &plane, mid)? else {
+                return Ok(None);
+            };
+            let on_face = surf_i.evaluate(mid[0], mid[1])?;
+            if distance(p, on_face) > 0.05 {
+                return Ok(None);
+            }
+            return Ok(Some((e, p)));
+        }
+    };
+    let p = match edge_point(&surf_i, &surf_j, mid) {
+        Ok(p) => p,
+        // Round-11 third pass: a partner that is degenerate at a pole along this
+        // edge does not converge; the edge is not split (the gap is never accepted).
+        Err(_) if crate::research::native_parametric_surface::third_rules() => return Ok(None),
+        Err(e) => return Err(e),
+    };
+    let on_face = surf_i.evaluate(mid[0], mid[1])?;
+    // The split must sit at the chord, not elsewhere on the intersection.
+    if distance(p, on_face) > 0.05 {
+        return Ok(None);
+    }
+    Ok(Some((e, p)))
+}
+
+/// The trimmed mesh of a parametric face whose trim the rectangular grid
+/// cannot draw. It is refused unless its shared edges agree with their
+/// neighbours, as the curved-profile path requires.
+pub(crate) fn face(g: &ObjectGraph, fi: usize) -> Result<FaceMesh> {
+    let f = g.objects.get(fi).context("face index")?;
+    ensure!(f.class_name == "Face", "not Face");
+    ensure!(
+        f.fields["m_faceRegions"]
+            .as_array()
+            .is_some_and(Vec::is_empty),
+        "face regions need subdivision"
+    );
+    let si = pointer(g, fi, &f.fields["m_pSurf"])?.context("face surface")?;
+    let surface = ParametricSurface::read(g, si)?;
+    let (error, unverifiable) = shared_edge_error(g, fi, &surface)?;
+    ensure!(
+        unverifiable == 0,
+        "shared edge with an unverifiable neighbour"
+    );
+    ensure!(
+        error <= SHARED_EDGE_TOLERANCE,
+        "shared edge disagrees with its neighbour"
+    );
+
+    // Every loop of the face, the outer one first among the rest by area.
+    let mut rings = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut next = pointer(g, fi, &f.fields["m_pFirstLoop"])?;
+    while let Some(li) = next {
+        ensure!(seen.insert(li), "loop-list cycle");
+        rings.push(closed_ring(&surface, loop_segments(g, fi, li, &surface)?)?);
+        next = pointer(g, li, &g.objects[li].fields["m_nextLoop"])?;
+    }
+    ensure!(!rings.is_empty(), "face has no trim loop");
+    let islands = crate::research::native_parametric_surface::new_rules();
+    mesh_rings(g, fi, &surface, rings, islands)
+}
+
+/// The trimmed mesh of face `fi` on `surface`, given its trim rings in UV.
+/// The outer ring is the one of largest area; the others are holes.
+/// Third pass: the meshes of the faces already meshed in this thread's
+/// current batch, by graph, face, islands flag and a hash of the surface and
+/// trim rings. The same face is reached through many selections, and its
+/// mesh depends on nothing else. Cleared at each batch by [`memo_reset`].
+type MemoKey = (usize, usize, bool, u64);
+thread_local! {
+    static MEMO: RefCell<BTreeMap<MemoKey, std::result::Result<FaceMesh, String>>> = const { RefCell::new(BTreeMap::new()) };
+}
+/// Forget the faces meshed so far: their graphs may be freed after a batch.
+pub(crate) fn memo_reset() {
+    MEMO.with(|m| m.borrow_mut().clear());
+}
+pub(crate) fn mesh_rings(
+    g: &ObjectGraph,
+    fi: usize,
+    surface: &ParametricSurface,
+    rings: Vec<Vec<Uv>>,
+    islands: bool,
+) -> Result<FaceMesh> {
+    let memo_on = crate::research::native_parametric_surface::THIRD_RULES
+        .load(std::sync::atomic::Ordering::Relaxed)
+        && !coarse();
+    if !memo_on {
+        return mesh_rings_timed(g, fi, surface, rings, islands);
+    }
+    let key: MemoKey = {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        format!("{surface:?}{rings:?}").hash(&mut h);
+        (g as *const ObjectGraph as usize, fi, islands, h.finish())
+    };
+    if let Some(hit) = MEMO.with(|m| m.borrow().get(&key).cloned()) {
+        return hit.clone().map_err(anyhow::Error::msg);
+    }
+    let r = mesh_rings_timed(g, fi, surface, rings, islands);
+    let stored = match &r {
+        Ok(m) => Ok(m.clone()),
+        Err(e) => Err(format!("{e:#}")),
+    };
+    MEMO.with(|m| m.borrow_mut().insert(key, stored));
+    r
+}
+fn mesh_rings_timed(
+    g: &ObjectGraph,
+    fi: usize,
+    surface: &ParametricSurface,
+    rings: Vec<Vec<Uv>>,
+    islands: bool,
+) -> Result<FaceMesh> {
+    mesh_rings_inner(g, fi, surface, rings, islands)
+}
+fn mesh_rings_inner(
+    g: &ObjectGraph,
+    fi: usize,
+    surface: &ParametricSurface,
+    rings: Vec<Vec<Uv>>,
+    islands: bool,
+) -> Result<FaceMesh> {
+    let f = g.objects.get(fi).context("face index")?;
+    let ring_set = rings.clone();
+    let outer_index = (0..rings.len())
+        .max_by(|&a, &b| signed_area(&rings[a]).abs().total_cmp(&signed_area(&rings[b]).abs()))
+        .context("no trim ring")?;
+    let outer = rings[outer_index].clone();
+    let holes: Vec<Vec<Uv>> = rings
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| *i != outer_index)
+        .map(|(_, r)| r.clone())
+        .collect();
+    let mut expected = signed_area(&outer).abs();
+    for (i, h) in holes.iter().enumerate() {
+        // Under `islands` (a cylinder face whose rings do not nest) a ring
+        // outside the outer one is a separate piece of the face, not a hole.
+        if islands && !inside(h[0], &outer) {
+            ensure!(
+                holes
+                    .iter()
+                    .enumerate()
+                    .all(|(j, other)| i == j || !inside(h[0], other)),
+                "nested trim islands unsupported"
+            );
+            expected += signed_area(h).abs();
+            continue;
+        }
+        ensure!(inside(h[0], &outer), "trim hole outside its outer loop");
+        ensure!(
+            holes
+                .iter()
+                .enumerate()
+                .all(|(j, other)| i == j || !inside(h[0], other)),
+            "nested trim holes unsupported"
+        );
+        expected -= signed_area(h).abs();
+    }
+    ensure!(expected > 1e-12, "degenerate parametric trim area");
+
+    // Triangulate the boundary samples with their holes.
+    let mut uv: Vec<Uv> = outer.clone();
+    let mut hole_starts = Vec::new();
+    for h in &holes {
+        hole_starts.push(uv.len() as u32);
+        uv.extend_from_slice(h);
+    }
+    let mut boundary_edges = BTreeSet::new();
+    let mut add_ring = |start: usize, len: usize| {
+        for k in 0..len {
+            let a = (start + k) as u32;
+            let b = (start + (k + 1) % len) as u32;
+            boundary_edges.insert((a.min(b), a.max(b)));
+        }
+    };
+    add_ring(0, outer.len());
+    for (h, &start) in holes.iter().zip(&hole_starts) {
+        add_ring(start as usize, h.len());
+    }
+    let rings: Vec<&[Uv]> = std::iter::once(outer.as_slice())
