+/// The point and its U and V partial derivatives of a bicubic Hermite patch,
+/// from the cell's four corner nodes.
+fn hermite_patch(
+    u_params: &[f64],
+    v_params: &[f64],
+    nodes: &[[Point; 4]],
+    u: f64,
+    v: f64,
+) -> (Point, Point, Point) {
+    let nu = u_params.len();
+    let (ju, s, hu) = hermite_cell(u_params, u);
+    let (iv, t, hv) = hermite_cell(v_params, v);
+    let (vs, ts, dvs, dts) = hermite_weights(s);
+    let (vt, tt, dvt, dtt) = hermite_weights(t);
+    let (mut p, mut pu, mut pv) = ([0.; 3], [0.; 3], [0.; 3]);
+    for a in 0..2 {
+        for b in 0..2 {
+            let c = nodes[(iv + b) * nu + (ju + a)];
+            // d/ds and d/dt of the corner's terms, before the cell scaling.
+            let ds = add(
+                add(mul(c[0], dvs[a] * vt[b]), mul(c[1], hu * dts[a] * vt[b])),
+                add(mul(c[2], hv * dvs[a] * tt[b]), mul(c[3], hu * hv * dts[a] * tt[b])),
+            );
+            let dt = add(
+                add(mul(c[0], vs[a] * dvt[b]), mul(c[1], hu * ts[a] * dvt[b])),
+                add(mul(c[2], hv * vs[a] * dtt[b]), mul(c[3], hu * hv * ts[a] * dtt[b])),
+            );
+            let value = add(
+                add(mul(c[0], vs[a] * vt[b]), mul(c[1], hu * ts[a] * vt[b])),
+                add(mul(c[2], hv * vs[a] * tt[b]), mul(c[3], hu * hv * ts[a] * tt[b])),
+            );
+            p = add(p, value);
+            pu = add(pu, mul(ds, 1. / hu));
+            pv = add(pv, mul(dt, 1. / hv));
+        }
+    }
+    (p, pu, pv)
+}
+
+fn hermite_segment(params: &[f64], t: f64) -> (usize, f64, f64) {
+    let last = params.len() - 2;
+    let i = params
+        .partition_point(|&x| x <= t)
+        .saturating_sub(1)
+        .min(last);
+    let h = params[i + 1] - params[i];
+    let s = ((t - params[i]) / h).clamp(0., 1.);
+    (i, h, s)
+}
+
+fn c_range_of(c: &Curve) -> [f64; 2] {
+    match c {
+        Curve::Line { range, .. }
+        | Curve::Arc { range, .. }
+        | Curve::Ellipse { range, .. }
+        | Curve::Hermite { range, .. } => *range,
+    }
+}
