+/// Whether an element that live leaves boxed has a decoder failure the
+/// round-6 rules can change: a multi-loop cylinder or a UV loop that does not
+/// join. Only these are decoded again; no admitted body in the corpus
+/// needed a surface-pointer candidate.
+fn round5_candidate(diagnostics: &[String]) -> bool {
+    diagnostics.iter().any(|d| {
+        [
+            "disconnected UV boundary",
+            "missing surface pointer target",
+        ]
+        .iter()
+        .any(|kind| d.contains(kind))
+    })
+}
