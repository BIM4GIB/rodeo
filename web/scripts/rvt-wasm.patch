+/// The chord tolerance, in document feet, that bounds every tessellated curve.
+const CHORD: f64 = 0.001;
+
+/// The largest gap, in document feet, a decoded surface may leave on a shared
+/// edge with its neighbour before the element keeps its record box.
+const SHARED_EDGE_TOLERANCE: f64 = 1e-4;
+
+/// The parameter step over which a curve with curvature-speed `r` (a circle's
+/// radius, see [`Curve::curvature_speed_max`]) deviates from its chords by at
+/// most [`CHORD`]: the angle subtended by one chord of the circle.
+fn chord_angle(r: f64) -> f64 {
+    (4. * (CHORD / (2. * r.max(CHORD))).min(1.).sqrt().asin()).min(std::f64::consts::FRAC_PI_2)
+}
+
+fn length3(p: [f64; 3]) -> f64 {
+    p.iter().map(|x| x * x).sum::<f64>().sqrt()
+}
+
+/// The largest distance from the axis of a revolution, over a profile
+/// parameter range, sampled densely.
+fn profile_radius(profile: &Curve, range: [f64; 2]) -> f64 {
+    (0..=256)
+        .map(|k| {
+            let t = range[0] + (range[1] - range[0]) * k as f64 / 256.;
+            let q = profile.eval(t);
+            q[0].hypot(q[1])
+        })
+        .fold(0., f64::max)
+}
+
+/// The segment count a ruled patch needs in its shared normalized grid.
+/// Two straight profiles keep the twist rule of straight generators. A curved
+/// profile is sampled so its chords stay within [`CHORD`]: a straight profile
+/// adds no chord error, and the other's curvature sets the count.
+fn ruled_segments(profile1: &Curve, profile2: &Curve) -> Result<f64> {
+    if let (
+        Curve::Line {
+            direction: a,
+            range: ra,
+            ..
+        },
+        Curve::Line {
+            direction: b,
+            range: rb,
+            ..
+        },
+    ) = (profile1, profile2)
+    {
+        let da = std::array::from_fn(|k| a[k] * (ra[1] - ra[0]));
+        let db = std::array::from_fn(|k| b[k] * (rb[1] - rb[0]));
+        let mixed = length3(std::array::from_fn(|k| da[k] - db[k]));
+        return Ok((mixed / CHORD)
+            .sqrt()
+            .ceil()
+            .max(length3(da).ceil())
+            .max(length3(db).ceil()));
+    }
+    let mut n = 1.0_f64;
+    for profile in [profile1, profile2] {
+        if matches!(profile, Curve::Line { .. }) {
+            continue;
+        }
+        let range = profile.range();
+        let step = chord_angle(profile.curvature_speed_max());
+        ensure!(
+            step.is_finite() && step > 0.,
+            "degenerate ruled profile chord step"
+        );
+        n = n.max(((range[1] - range[0]) / step).ceil());
+    }
+    Ok(n)
+}
