+/// `savedMeshes` as the page gives it: true or false, or "all".
+#[derive(serde::Deserialize)]
+#[serde(untagged)]
+enum SavedMeshesOption {
+    On(bool),
+    Scope(String),
+}
+
+impl SavedMeshesOption {
+    fn into_choice(self) -> Result<SavedMeshChoice, JsValue> {
+        match self {
+            Self::On(true) => Ok(SavedMeshChoice::Default),
+            Self::On(false) => Ok(SavedMeshChoice::Off),
+            Self::Scope(scope) if scope == "all" => Ok(SavedMeshChoice::All),
+            Self::Scope(scope) => Err(JsValue::from_str(&format!(
+                "savedMeshes must be true, false or \"all\", got {scope:?}"
+            ))),
+        }
+    }
+}
