+/// The 3D point of face `face` at `uv`, for the surfaces the shared-edge
+/// check evaluates (planes, and the parametric surfaces above). `None` leaves
+/// the neighbour unverifiable.
+fn face_point(g: &ObjectGraph, face: usize, uv: [f64; 2]) -> Result<Option<[f64; 3]>> {
+    use crate::native_saved_mesh::pointer;
+    let f = &g.objects[face];
+    let Some(si) = pointer(g, face, &f.fields["m_pSurf"])? else {
+        return Ok(None);
+    };
+    let s = &g.objects[si];
+    let vec3 = |v: &serde_json::Value| -> Result<[f64; 3]> {
+        let a = v.as_array().context("vector")?;
+        ensure!(a.len() == 3, "vector dimension");
+        let r = [
+            a[0].as_f64().context("vector number")?,
+            a[1].as_f64().context("vector number")?,
+            a[2].as_f64().context("vector number")?,
+        ];
+        ensure!(r.iter().all(|x| x.is_finite()), "nonfinite vector");
+        Ok(r)
+    };
+    match s.class_name.as_str() {
+        "Plane" => {
+            let o = vec3(&s.fields["m_origin"])?;
+            let x = vec3(&s.fields["m_xVec"])?;
+            let y = vec3(&s.fields["m_yVec"])?;
+            Ok(Some(std::array::from_fn(|k| {
+                o[k] + uv[0] * x[k] + uv[1] * y[k]
+            })))
+        }
+        "CylSurf" => {
+            let center = vec3(&s.fields["m_center"])?;
+            let radius = s.fields["m_radius"].as_f64().context("cylinder radius")?;
+            ensure!(radius.is_finite() && radius > 0., "invalid cylinder radius");
+            let x = vec3(&s.fields["m_xVec"])?;
+            let y = vec3(&s.fields["m_yVec"])?;
+            let z = vec3(&s.fields["m_zVec"])?;
+            let (sn, cs) = uv[0].sin_cos();
+            Ok(Some(std::array::from_fn(|k| {
+                center[k] + radius * (cs * x[k] + sn * y[k]) + uv[1] * z[k]
+            })))
+        }
+        "RuledSurf" | "SurfRev" | "ConeSurf" => {
+            let surface = ParametricSurface::read(g, si)?;
+            let e = surface.bounds();
+            let u = uv[0].clamp(e[0][0], e[1][0]);
+            let v = uv[1].clamp(e[0][1], e[1][1]);
+            Ok(Some(surface.evaluate(u, v)?))
+        }
+        _ => Ok(None),
+    }
+}
