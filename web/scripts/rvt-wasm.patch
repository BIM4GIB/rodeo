+/// The largest distance, over the samples of every edge this face shares
+/// with a neighbour, between this face's surface and the neighbour's at the
+/// same edge sample. Returns `(error, unverifiable edges)`.
+fn shared_edge_error(
+    g: &ObjectGraph,
+    fi: usize,
+    surface: &ParametricSurface,
+) -> Result<(f64, usize)> {
+    use crate::native_saved_mesh::pointer;
+    let mut error = 0_f64;
+    let mut unverifiable = 0;
+    for (ei, edge) in g
+        .objects
+        .iter()
+        .enumerate()
+        .filter(|(_, o)| o.class_name == "Edge")
+    {
+        let Some(faces) = edge.fields.get("m_pFace").and_then(|v| v.as_array()) else {
+            continue;
+        };
+        if faces.len() != 2 {
+            continue;
+        }
+        let resolved = [
+            pointer(g, ei, &faces[0]).ok().flatten(),
+            pointer(g, ei, &faces[1]).ok().flatten(),
+        ];
+        let side = match resolved {
+            [Some(a), Some(b)] if a == fi && b != fi => 0,
+            [Some(a), Some(b)] if b == fi && a != fi => 1,
+            _ => continue,
+        };
+        let other = resolved[1 - side].context("shared edge partner")?;
+        let ends = edge
+            .fields
+            .get("m_firstAndLastEdgePnts")
+            .and_then(|v| v.as_array())
+            .context("edge endpoints")?;
+        let interior = edge
+            .fields
+            .get("m_interiorEdgePnts")
+            .and_then(|v| v.as_array())
+            .context("edge interior samples")?;
+        let mut samples = vec![&ends[0]];
