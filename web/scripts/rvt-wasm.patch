+                let (Some(&pa), Some(&pb)) = (
+                    primitive.vertices.get(t[a] as usize),
+                    primitive.vertices.get(t[b] as usize),
+                ) else {
+                    continue;
+                };
+                let (ka, kb) = (key(pa), key(pb));
+                let k = if ka <= kb { (ka, kb) } else { (kb, ka) };
+                let mid = std::array::from_fn(|i| (pa[i] + pb[i]) * 0.5);
+                edges.entry(k).or_insert((0, mid)).0 += 1;
+            }
+        }
+    }
+    let open: Vec<[f64; 3]> = edges
+        .values()
+        .filter(|(n, _)| *n == 1)
+        .map(|(_, m)| *m)
+        .collect();
+    if open.is_empty() {
+        return true;
+    }
+    (0..3).any(|axis| {
+        let lo = open.iter().map(|m| m[axis]).fold(f64::INFINITY, f64::min);
+        let hi = open.iter().map(|m| m[axis]).fold(f64::NEG_INFINITY, f64::max);
+        hi - lo <= 0.05
+    })
+}
+
+/// Whether the open edges across all the primitives (their vertices merged
+/// within [`VISUAL`]) lie within 0.05 ft of one plane parallel to an axis, or
+/// there are none. An open edge that lies along other open edges within
+/// [`VISUAL`] is a T-junction where a finer sampled side meets a coarser one,
+/// which Revit draws closed, so it is not counted: only genuine gaps are.
+fn open_edges_form_one_rim(primitives: &[Primitive]) -> bool {
+    let mut offset = Vec::with_capacity(primitives.len());
+    let mut points: Vec<[f64; 3]> = Vec::new();
+    for p in primitives {
+        offset.push(points.len());
+        points.extend_from_slice(&p.vertices);
+    }
+    // Vertices within VISUAL of each other are one vertex (union-find over a
+    // grid of VISUAL cells, so only neighbouring cells are compared).
+    let mut parent: Vec<usize> = (0..points.len()).collect();
+    let mut grid: HashMap<[i64; 3], Vec<usize>> = HashMap::new();
+    for (i, &p) in points.iter().enumerate() {
+        let c = p.map(|x| (x / VISUAL).floor() as i64);
+        for dx in -1..=1 {
+            for dy in -1..=1 {
+                for dz in -1..=1 {
+                    let Some(list) = grid.get(&[c[0] + dx, c[1] + dy, c[2] + dz]) else {
+                        continue;
+                    };
+                    for &j in list {
+                        if distance(p, points[j]) < VISUAL {
+                            let (ri, rj) = (find(&mut parent, i), find(&mut parent, j));
+                            parent[ri] = rj;
+                        }
+                    }
+                }
+            }
+        }
+        grid.entry(c).or_default().push(i);
+    }
+    let mut edges: BTreeMap<(usize, usize), (usize, [f64; 3], [f64; 3])> = BTreeMap::new();
+    for (pi, primitive) in primitives.iter().enumerate() {
+        for t in &primitive.triangles {
+            for (a, b) in [(0, 1), (1, 2), (2, 0)] {
+                let (Some(_), Some(_)) = (
+                    primitive.vertices.get(t[a] as usize),
+                    primitive.vertices.get(t[b] as usize),
+                ) else {
+                    continue;
+                };
+                let (ia, ib) = (offset[pi] + t[a] as usize, offset[pi] + t[b] as usize);
+                let (ca, cb) = (find(&mut parent, ia), find(&mut parent, ib));
+                if ca == cb {
+                    continue;
+                }
+                edges
+                    .entry((ca.min(cb), ca.max(cb)))
+                    .or_insert((0, points[ia], points[ib]))
+                    .0 += 1;
+            }
+        }
+    }
+    let open: Vec<([f64; 3], [f64; 3])> = edges
+        .values()
+        .filter(|(n, _, _)| *n == 1)
+        .map(|(_, a, b)| (*a, *b))
+        .collect();
+    if open.is_empty() {
+        return true;
+    }
+    let boxes: Vec<([f64; 3], [f64; 3])> = open
+        .iter()
+        .map(|(a, b)| {
+            (
+                std::array::from_fn(|k| a[k].min(b[k]) - VISUAL),
+                std::array::from_fn(|k| a[k].max(b[k]) + VISUAL),
+            )
+        })
+        .collect();
+    let mut gaps = Vec::new();
+    for (i, &(a, b)) in open.iter().enumerate() {
+        let lies_on_another = (0..=4).all(|k| {
+            let t = k as f64 / 4.;
+            let p: [f64; 3] = std::array::from_fn(|c| a[c] + t * (b[c] - a[c]));
+            (0..open.len()).any(|j| {
+                let (lo, hi) = boxes[j];
+                j != i
+                    && (0..3).all(|c| p[c] >= lo[c] && p[c] <= hi[c])
+                    && segment_distance3(p, open[j].0, open[j].1) <= VISUAL
+            })
+        });
+        if !lies_on_another {
+            gaps.push(std::array::from_fn::<f64, 3, _>(|c| (a[c] + b[c]) * 0.5));
+        }
+    }
+    if gaps.is_empty() {
+        return true;
+    }
+    (0..3).any(|axis| {
+        let lo = gaps.iter().map(|m| m[axis]).fold(f64::INFINITY, f64::min);
+        let hi = gaps.iter().map(|m| m[axis]).fold(f64::NEG_INFINITY, f64::max);
+        hi - lo <= 0.05
+    })
+}
+
+/// The union-find root of `i`, halving the path as it goes.
+fn find(parent: &mut [usize], mut i: usize) -> usize {
+    while parent[i] != i {
+        parent[i] = parent[parent[i]];
+        i = parent[i];
+    }
+    i
+}
+
+/// The distance from `p` to the segment `a`-`b` in 3D.
+fn segment_distance3(p: [f64; 3], a: [f64; 3], b: [f64; 3]) -> f64 {
+    let d: [f64; 3] = std::array::from_fn(|k| b[k] - a[k]);
+    let len2: f64 = d.iter().map(|x| x * x).sum();
+    let t = if len2 > 0. {
+        ((0..3).map(|k| (p[k] - a[k]) * d[k]).sum::<f64>() / len2).clamp(0., 1.)
+    } else {
+        0.
+    };
+    distance(p, std::array::from_fn(|k| a[k] + t * d[k]))
+}
+
 fn transform(p: &mut Primitive, m: [[f64; 4]; 4]) -> Result<()> {
     let a = [m[0][0], m[1][0], m[2][0]];
     let b = [m[0][1], m[1][1], m[2][1]];
