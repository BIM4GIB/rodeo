+//! Parametric faces whose saved trim is not a UV rectangle. Each trim loop is
+//! read as a UV polygon; the polygon with its holes is triangulated on its own
+//! boundary samples, which are the samples neighbouring faces share, and the
+//! triangles are split at their centroids until the surface stays within
+//! [`CHORD`] of its linear mapping. A split leaves every boundary edge in
+//! place, so the mesh stays conforming. Anything else is refused and the
+//! element keeps its record box.
+
+use crate::native_parameters::ObjectGraph;
+use crate::native_parametric_mesh::{
+    CHORD, DISPLAY_TOLERANCE, SHARED_EDGE_TOLERANCE, VISUAL, shared_edge_error,
+};
+use crate::native_parametric_surface::ParametricSurface;
+use crate::native_saved_mesh::{FaceMesh, pointer};
+use crate::vector_math::distance;
+use anyhow::{Context, Result, bail, ensure};
+use std::collections::{BTreeMap, BTreeSet};
+
+/// The most vertices one trimmed face may build.
+const MAX_VERTICES: usize = 200_000;
+/// The most triangles one trimmed face may build.
+const MAX_TRIANGLES: usize = 400_000;
+/// The error text the rectangular grid gives a non-rectangular trim.
+pub(crate) const NONRECTANGULAR: &str = "nonrectangular parametric trim";
+
+type Uv = [f64; 2];
+
+/// Whether `fi`'s rectangular grid refuses only because its trim is not a
+/// UV rectangle, so that this module draws it instead.
+pub(crate) fn is_trimmed_fallback(g: &ObjectGraph, fi: usize) -> bool {
+    match crate::native_parametric_mesh::face_grid(g, fi) {
+        Ok(_) => false,
+        Err(e) => e.to_string() == NONRECTANGULAR,
+    }
+}
+
+fn point3(surface: &ParametricSurface, uv: Uv) -> Result<[f64; 3]> {
+    surface.evaluate(uv[0], uv[1])
+}
+
+/// The UV samples of one trim loop's edges, in loop order, each edge read on
+/// the side of `fi`.
+fn loop_segments(g: &ObjectGraph, fi: usize, li: usize) -> Result<Vec<Vec<Uv>>> {
+    let l = &g.objects[li];
+    ensure!(
+        ["EdgeLoop", "EdgeLoopWithChainEnvelopes"].contains(&l.class_name.as_str()),
+        "unsupported trim loop"
+    );
+    ensure!(l.fields["m_open"] == false, "open trim loop");
+    ensure!(
+        pointer(g, li, &l.fields["m_pFace"])? == Some(fi),
+        "loop owner mismatch"
+    );
+    let mut cur = pointer(g, li, &l.fields["m_next"])?.context("empty trim")?;
+    let mut seen = BTreeSet::new();
+    let mut segments = Vec::new();
+    while cur != li {
+        ensure!(seen.insert(cur), "trim edge cycle");
+        let e = &g.objects[cur];
+        ensure!(e.class_name == "Edge", "nonedge trim member");
+        let faces = e.fields["m_pFace"].as_array().context("edge face pair")?;
+        ensure!(faces.len() == 2, "edge face pair length");
+        let mut side = None;
+        for (i, p) in faces.iter().enumerate() {
+            if pointer(g, cur, p)? == Some(fi) {
+                ensure!(side.is_none(), "ambiguous face side");
+                side = Some(i);
+            }
+        }
+        let side = side.context("edge does not belong to face")?;
+        let ends = e.fields["m_firstAndLastEdgePnts"]
+            .as_array()
+            .context("edge endpoints")?;
+        ensure!(ends.len() == 2, "edge endpoint count");
+        let uv = |v: &serde_json::Value| -> Result<Uv> {
+            let a = v.as_array().context("UV array")?;
+            ensure!(a.len() == 2, "UV dimension");
+            let p = [
+                a[0].as_f64().context("UV number")?,
+                a[1].as_f64().context("UV number")?,
+            ];
+            ensure!(p.iter().all(|x| x.is_finite()), "nonfinite UV");
+            Ok(p)
+        };
+        let mut points = vec![uv(&ends[0]["uv"][side])?];
+        for p in e.fields["m_interiorEdgePnts"]
+            .as_array()
+            .context("edge interior points")?
+        {
+            points.push(uv(&p["uv"][side])?);
+        }
+        points.push(uv(&ends[1]["uv"][side])?);
+        segments.push(points);
+        cur = pointer(g, cur, &e.fields["m_next"][side])?.context("null trim next")?;
+    }
+    ensure!(!segments.is_empty(), "too few parametric edges");
+    Ok(segments)
+}
+
+/// Joins a loop's edge samples into one closed UV ring, end to end in 3D.
+fn closed_ring(surface: &ParametricSurface, segments: Vec<Vec<Uv>>) -> Result<Vec<Uv>> {
+    let env = surface.bounds();
+    let segments = segments
+        .into_iter()
+        .map(|seg| {
+            seg.into_iter()
+                .map(|p| {
+                    for k in 0..2 {
+                        ensure!(
+                            p[k] >= env[0][k] - 1e-7 && p[k] <= env[1][k] + 1e-7,
+                            "trim outside surface envelope"
+                        );
+                    }
+                    Ok([p[0].clamp(env[0][0], env[1][0]), p[1].clamp(env[0][1], env[1][1])])
+                })
+                .collect::<Result<Vec<_>>>()
+        })
+        .collect::<Result<Vec<_>>>()?;
+    // Corners join within 1e-7 of each other in 3D; failing every ordering
+    // that way, within VISUAL.
+    for tolerance in [1e-7, VISUAL] {
+        for reverse in [false, true] {
+            let mut ring: Vec<Uv> = segments[0].clone();
+            if reverse {
+                ring.reverse();
+            }
+            let mut valid = true;
+            for seg in &segments[1..] {
+                let last = point3(surface, *ring.last().context("empty ring")?)?;
+                let a = seg[0];
+                let b = *seg.last().context("empty segment")?;
+                if distance(last, point3(surface, a)?) < tolerance {
+                    ring.extend_from_slice(&seg[1..]);
+                } else if distance(last, point3(surface, b)?) < tolerance {
+                    ring.extend(seg.iter().rev().skip(1).copied());
+                } else {
+                    valid = false;
+                    break;
+                }
+            }
+            if valid
+                && distance(
+                    point3(surface, ring[0])?,
+                    point3(surface, *ring.last().context("empty ring")?)?,
+                ) < tolerance
+            {
+                ring.pop();
+                ring.dedup_by(|a, b| (a[0] - b[0]).abs() < 1e-12 && (a[1] - b[1]).abs() < 1e-12);
+                while ring.len() > 1 {
+                    let (first, last) = (ring[0], *ring.last().unwrap());
+                    if (first[0] - last[0]).abs() < 1e-12 && (first[1] - last[1]).abs() < 1e-12 {
+                        ring.pop();
+                    } else {
+                        break;
+                    }
+                }
+                ensure!(ring.len() >= 3, "degenerate trim ring");
+                return Ok(ring);
+            }
+        }
+    }
+    bail!("disconnected parametric trim")
+}
+
+/// Twice the signed area of the UV triangle (a, b, c).
+fn cross2(a: Uv, b: Uv, c: Uv) -> f64 {
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
+
+fn signed_area(r: &[Uv]) -> f64 {
+    0.5 * (0..r.len())
+        .map(|i| {
+            let a = r[i];
+            let b = r[(i + 1) % r.len()];
+            a[0] * b[1] - b[0] * a[1]
+        })
+        .sum::<f64>()
+}
+
+/// Whether `p` lies inside `r` by the even-odd rule.
+fn inside(p: Uv, r: &[Uv]) -> bool {
+    let mut hit = false;
+    for i in 0..r.len() {
+        let a = r[i];
+        let b = r[(i + 1) % r.len()];
+        if (a[1] > p[1]) != (b[1] > p[1]) && p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0] {
+            hit = !hit;
+        }
+    }
+    hit
+}
+
+/// The distance from `p` to the segment `a`-`b`.
+fn segment_distance(p: Uv, a: Uv, b: Uv) -> f64 {
+    let (dx, dy) = (b[0] - a[0], b[1] - a[1]);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0. {
+        (((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / len2).clamp(0., 1.)
+    } else {
+        0.
+    };
+    (p[0] - (a[0] + t * dx)).hypot(p[1] - (a[1] + t * dy))
+}
+
+/// The point of `tris` containing `p` strictly, if any.
+fn containing(uv: &[Uv], tris: &[[u32; 3]], p: Uv) -> Option<usize> {
+    tris.iter().position(|t| {
+        let [a, b, c] = [uv[t[0] as usize], uv[t[1] as usize], uv[t[2] as usize]];
+        cross2(a, b, p) > 1e-12 && cross2(b, c, p) > 1e-12 && cross2(c, a, p) > 1e-12
+    })
+}
+
+/// The triangulation of the boundary `tris` with interior lattice points
+/// added at `divisions` per UV-box axis, each split into its triangle.
+fn lattice_refine(
+    outer: &[Uv],
+    holes: &[Vec<Uv>],
+    boundary: &[Uv],
+    tris: &[[u32; 3]],
+    divisions: usize,
+) -> Result<(Vec<Uv>, Vec<[u32; 3]>)> {
+    let mut uv = boundary.to_vec();
+    let mut tris = tris.to_vec();
+    if divisions == 0 {
+        return Ok((uv, tris));
+    }
+    let min: Uv = std::array::from_fn(|k| outer.iter().map(|p| p[k]).fold(f64::INFINITY, f64::min));
+    let max: Uv = std::array::from_fn(|k| outer.iter().map(|p| p[k]).fold(f64::NEG_INFINITY, f64::max));
+    let step = [(max[0] - min[0]) / divisions as f64, (max[1] - min[1]) / divisions as f64];
+    let rings: Vec<&[Uv]> = std::iter::once(outer).chain(holes.iter().map(Vec::as_slice)).collect();
+    for i in 1..divisions {
+        for j in 1..divisions {
+            let p = [min[0] + step[0] * i as f64, min[1] + step[1] * j as f64];
+            let inside_trim = inside(p, outer) && holes.iter().all(|h| !inside(p, h));
+            if !inside_trim {
+                continue;
+            }
+            // Keep lattice points off the boundary so no triangle is a sliver.
+            let clear = rings.iter().all(|r| {
+                (0..r.len()).all(|k| {
+                    segment_distance(p, r[k], r[(k + 1) % r.len()]) > 0.25 * step[0].min(step[1])
+                })
+            });
+            if !clear {
+                continue;
+            }
+            let Some(t) = containing(&uv, &tris, p) else {
+                continue;
+            };
+            ensure!(tris.len() < MAX_TRIANGLES && uv.len() < MAX_VERTICES, "trimmed face exceeds its budget");
+            let q = uv.len() as u32;
+            uv.push(p);
+            let [a, b, c] = tris[t];
+            tris[t] = [a, b, q];
+            tris.push([b, c, q]);
+            tris.push([c, a, q]);
+        }
+    }
+    Ok((uv, tris))
+}
+
+/// The deviation a triangle touching the trim boundary may show: the largest
+/// sagitta of the boundary's own samples, the chord each saved sample pair
+/// makes against the surface at the middle of its UV span. Revit's boundary
+/// is drawn with that deviation, so a triangle along it is not held finer
+/// than the samples are; it is clamped to [`CHORD`, `DISPLAY_TOLERANCE`].
+/// Interior triangles keep [`CHORD`].
+fn boundary_tolerance(surface: &ParametricSurface, rings: &[&[Uv]]) -> Result<f64> {
+    let mut sagitta = 0_f64;
+    for ring in rings {
+        for k in 0..ring.len() {
+            let (a, b) = (ring[k], ring[(k + 1) % ring.len()]);
+            let (pa, pb) = (point3(surface, a)?, point3(surface, b)?);
+            let chord: [f64; 3] = std::array::from_fn(|i| (pa[i] + pb[i]) / 2.);
+            let mid = point3(surface, [(a[0] + b[0]) / 2., (a[1] + b[1]) / 2.])?;
+            sagitta = sagitta.max(distance(mid, chord));
+        }
+    }
+    Ok(sagitta.clamp(CHORD, DISPLAY_TOLERANCE))
+}
+
+/// Whether every triangle's surface stays within its tolerance of its linear
+/// mapping: [`CHORD`] for interior triangles, `boundary_tol` for those with a
+/// vertex among the first `boundary_count` (the trim samples, which are not
+/// refined).
+fn within_chord(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    boundary_count: usize,
+    boundary_tol: f64,
+) -> Result<bool> {
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(surface, p)).collect::<Result<_>>()?;
+    for &[a, b, c] in tris {
+        let tol = if [a, b, c].iter().any(|&k| (k as usize) < boundary_count) {
+            boundary_tol
+        } else {
+            CHORD
+        };
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        let (qa, qb, qc) = (verts3[a as usize], verts3[b as usize], verts3[c as usize]);
+        let samples = [
+            ([1. / 3., 1. / 3., 1. / 3.], [(pa[0] + pb[0] + pc[0]) / 3., (pa[1] + pb[1] + pc[1]) / 3.]),
+            ([0.5, 0.5, 0.], [(pa[0] + pb[0]) / 2., (pa[1] + pb[1]) / 2.]),
+            ([0., 0.5, 0.5], [(pb[0] + pc[0]) / 2., (pb[1] + pc[1]) / 2.]),
+            ([0.5, 0., 0.5], [(pa[0] + pc[0]) / 2., (pa[1] + pc[1]) / 2.]),
+        ];
+        for (w, s) in samples {
+            let true_point = point3(surface, s)?;
+            let linear: [f64; 3] = std::array::from_fn(|k| w[0] * qa[k] + w[1] * qb[k] + w[2] * qc[k]);
+            if distance(true_point, linear) > tol {
+                return Ok(false);
+            }
+        }
+    }
+    Ok(true)
+}
+
+/// The trimmed mesh of a parametric face whose trim the rectangular grid
+/// cannot draw. It is refused unless its shared edges agree with their
+/// neighbours, as the curved-profile path requires.
+pub(crate) fn face(g: &ObjectGraph, fi: usize) -> Result<FaceMesh> {
+    let f = g.objects.get(fi).context("face index")?;
+    ensure!(f.class_name == "Face", "not Face");
+    ensure!(
+        f.fields["m_faceRegions"]
+            .as_array()
+            .is_some_and(Vec::is_empty),
+        "face regions need subdivision"
+    );
+    let si = pointer(g, fi, &f.fields["m_pSurf"])?.context("face surface")?;
+    let surface = ParametricSurface::read(g, si)?;
+    let (error, unverifiable) = shared_edge_error(g, fi, &surface)?;
+    ensure!(
+        unverifiable == 0,
+        "shared edge with an unverifiable neighbour"
+    );
+    ensure!(
+        error <= SHARED_EDGE_TOLERANCE,
+        "shared edge disagrees with its neighbour"
+    );
+
+    // Every loop of the face, the outer one first among the rest by area.
+    let mut rings = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut next = pointer(g, fi, &f.fields["m_pFirstLoop"])?;
+    while let Some(li) = next {
+        ensure!(seen.insert(li), "loop-list cycle");
+        rings.push(closed_ring(&surface, loop_segments(g, fi, li)?)?);
+        next = pointer(g, li, &g.objects[li].fields["m_nextLoop"])?;
+    }
+    ensure!(!rings.is_empty(), "face has no trim loop");
+    let outer_index = (0..rings.len())
+        .max_by(|&a, &b| signed_area(&rings[a]).abs().total_cmp(&signed_area(&rings[b]).abs()))
+        .context("no trim ring")?;
+    let outer = rings[outer_index].clone();
+    let holes: Vec<Vec<Uv>> = rings
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| *i != outer_index)
+        .map(|(_, r)| r.clone())
+        .collect();
+    let mut expected = signed_area(&outer).abs();
+    for (i, h) in holes.iter().enumerate() {
+        ensure!(inside(h[0], &outer), "trim hole outside its outer loop");
+        ensure!(
+            holes
+                .iter()
+                .enumerate()
+                .all(|(j, other)| i == j || !inside(h[0], other)),
+            "nested trim holes unsupported"
+        );
+        expected -= signed_area(h).abs();
+    }
+    ensure!(expected > 1e-12, "degenerate parametric trim area");
+
+    // Triangulate the boundary samples with their holes.
+    let mut uv: Vec<Uv> = outer.clone();
+    let mut hole_starts = Vec::new();
+    for h in &holes {
+        hole_starts.push(uv.len() as u32);
+        uv.extend_from_slice(h);
+    }
+    let mut boundary_edges = BTreeSet::new();
+    let mut add_ring = |start: usize, len: usize| {
+        for k in 0..len {
+            let a = (start + k) as u32;
+            let b = (start + (k + 1) % len) as u32;
+            boundary_edges.insert((a.min(b), a.max(b)));
+        }
+    };
+    add_ring(0, outer.len());
+    for (h, &start) in holes.iter().zip(&hole_starts) {
+        add_ring(start as usize, h.len());
+    }
+    let mut indices = Vec::<u32>::new();
+    earcut::Earcut::new().earcut(uv.iter().copied(), &hole_starts, &mut indices);
+    ensure!(!indices.is_empty() && indices.len() % 3 == 0, "triangulation failed");
+    let mut tris: Vec<[u32; 3]> = Vec::new();
+    let mut sum = 0.;
+    for t in indices.chunks_exact(3) {
+        let t = [t[0], t[1], t[2]];
+        ensure!(t.iter().all(|&k| (k as usize) < uv.len()), "triangle bounds");
+        let a = cross2(uv[t[0] as usize], uv[t[1] as usize], uv[t[2] as usize]);
+        if a.abs() <= 1e-14 {
+            continue;
+        }
+        sum += a.abs() * 0.5;
+        tris.push(if a > 0. { t } else { [t[0], t[2], t[1]] });
+    }
+    ensure!(
+        (sum - expected).abs() <= 1e-7 * expected.max(1e-6),
+        "triangulated area mismatch"
+    );
+    // Interior points are added on a lattice, one containing triangle at a
+    // time, so every boundary sample and boundary edge stays as it is. The
+    // coarsest lattice whose triangles all stay within CHORD of the surface is
+    // taken; none is refused.
+    let rings: Vec<&[Uv]> = std::iter::once(outer.as_slice())
+        .chain(holes.iter().map(Vec::as_slice))
+        .collect();
+    let boundary_tol = boundary_tolerance(&surface, &rings)?;
+    let boundary_count = uv.len();
+    let mut found = None;
+    for divisions in [0_usize, 8, 16, 32, 64] {
+        let (points, tris) = lattice_refine(&outer, &holes, &uv, &tris, divisions)?;
+        if within_chord(&surface, &points, &tris, boundary_count, boundary_tol)? {
+            found = Some((points, tris));
+            break;
+        }
+    }
+    let (uv, done) = found.context("trimmed face needs a finer interior lattice")?;
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(&surface, p)).collect::<Result<_>>()?;
+    {
+        // The boundary is still the samples' own: each boundary edge is used
+        // once, each interior edge twice.
+        let mut uses: BTreeMap<(u32, u32), u32> = BTreeMap::new();
+        for t in &done {
+            for (a, b) in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+                *uses.entry((a.min(b), a.max(b))).or_default() += 1;
+            }
+        }
+        for (edge, count) in &uses {
+            ensure!(
+                if boundary_edges.contains(edge) { *count == 1 } else { *count == 2 },
+                "trim triangulation is not a manifold"
+            );
+        }
+        ensure!(
+            boundary_edges.iter().all(|e| uses.contains_key(e)),
+            "trim boundary not covered"
+        );
+    }
+
+    // Normals and winding follow the grid's rule (tessellate_uv): the
+    // surface's own orientation against the face's flag.
+    let flags = f.fields["m_faceFlags_v9"].as_u64().context("face flags")?;
+    let orient = flags & 2 == 0;
+    let winding = surface.orientation() == orient;
+    let area3 = |x: u32, y: u32, z: u32| {
+        let p = verts3[x as usize];
+        let q = verts3[y as usize];
+        let r = verts3[z as usize];
+        let u = [q[0] - p[0], q[1] - p[1], q[2] - p[2]];
+        let v = [r[0] - p[0], r[1] - p[1], r[2] - p[2]];
+        (u[1] * v[2] - u[2] * v[1])
+            .hypot((u[2] * v[0] - u[0] * v[2]).hypot(u[0] * v[1] - u[1] * v[0]))
+    };
+    let collapsed = |x: u32, y: u32| {
+        let p = verts3[x as usize];
+        let q = verts3[y as usize];
+        (0..3).map(|k| (q[k] - p[k]).powi(2)).sum::<f64>() <= 1e-20
+    };
+    let mut remap = vec![u32::MAX; verts3.len()];
+    let mut vertices = Vec::new();
+    let mut normals = Vec::new();
+    let mut triangles = Vec::new();
+    for t in &done {
+        let [a, b, c] = *t;
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        // The triangle is counter-clockwise in UV, as the grid's are.
+        let ccw = cross2(pa, pb, pc) > 0.;
+        let (x, y, z) = if ccw { (a, b, c) } else { (a, c, b) };
+        if area3(x, y, z) <= 1e-12 {
+            ensure!(
+                collapsed(x, y) || collapsed(y, z) || collapsed(z, x),
+                "noncollapsed degenerate parametric triangle"
+            );
+            continue;
+        }
+        let mut out = [0u32; 3];
+        for (slot, &vi) in [x, y, z].iter().enumerate() {
+            if remap[vi as usize] == u32::MAX {
+                let p = uv[vi as usize];
+                remap[vi as usize] = vertices.len() as u32;
+                vertices.push(verts3[vi as usize]);
+                let mut n = surface.normal(p[0], p[1])?;
+                if !orient {
+                    for value in &mut n {
+                        *value = -*value;
+                    }
+                }
+                normals.push(n);
+            }
+            out[slot] = remap[vi as usize];
+        }
+        triangles.push(if winding { out } else { [out[0], out[2], out[1]] });
+    }
+    ensure!(!triangles.is_empty(), "trimmed parametric face produced no triangles");
+    let normal = normals[0];
+    Ok(FaceMesh {
+        face_index: fi,
+        face_tag: f.fields["m_GInfo"]["m_tag"].as_i64().unwrap_or(-1),
+        render_style_id: crate::native_metadata::identifier(&f.fields["m_renderStyleId"])?,
+        normal,
+        vertices,
+        normals,
+        triangles,
+        analytic_surface: None,
+        trim_uv: outer,
+    })
+}
